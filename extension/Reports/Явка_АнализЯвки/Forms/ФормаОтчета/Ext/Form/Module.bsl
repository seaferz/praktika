
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("Мероприятие") Тогда
		Мероприятие = Параметры.Мероприятие;
		СформироватьНаСервере();
		Если Параметры.Свойство("ПоказатьДиаграмму") И Параметры.ПоказатьДиаграмму Тогда
			Элементы.РезультатОтчета.Видимость = Ложь;
			Элементы.ДиаграммаОтчета.Видимость = Истина;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	СформироватьНаСервере();
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
	Таблица = Новый ТабличныйДокумент;
	Таблица.ОтображатьСетку = Ложь;
	Таблица.ОтображатьЗаголовки = Ложь;
	Таблица.Область("R1C1").Текст = "Явка участников соревнования";
	Таблица.Область("R1C1").Шрифт = Новый Шрифт("Arial", 15, Истина);
	ДиаграммаОтчета.Очистить();
	Если Не Явка_Правила.Действует(Мероприятие) Тогда
		Таблица.Область("R3C1").Текст = "Выберите действующее проведенное мероприятие.";
		РезультатОтчета = Таблица;
		Элементы.РезультатОтчета.Видимость = Истина;
		Элементы.ДиаграммаОтчета.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	Таблица.Область("R2C1").Текст = Строка(Мероприятие);
	Данные = Явка_Правила.ДанныеОтчета(Мероприятие);
	ДиаграммаОтчета.ТипДиаграммы = ТипДиаграммы.Круговая;
	Точка = ДиаграммаОтчета.Точки.Добавить("Участники");
	Итоги = Новый Структура("Явились,НеЯвились,БезОтметки", Данные.Явились, Данные.НеЯвились, Данные.БезОтметки);
	Таблица.Область("R4C1").Текст = "Зарегистрировано";
	Таблица.Область("R4C2").Текст = Строка(Данные.Зарегистрировано);
	Таблица.Область("R3C2").Текст = "Количество";
	Таблица.Область("R3C3").Текст = "Доля";
	Таблица.Область("R3C3").ШиринаКолонки = 17;
	СтрокаДокумента = 4;
	Для Каждого Итог Из Итоги Цикл
		Подпись = ?(Итог.Ключ = "Явились", "Явились", ?(Итог.Ключ = "НеЯвились", "Не явились", "Без отметки"));
		СтрокаДокумента = СтрокаДокумента + 1;
		Таблица.Область(СтрокаДокумента, 1).Текст = Подпись;
		Таблица.Область(СтрокаДокумента, 2).Текст = Строка(Итог.Значение);
		Доля = ?(Данные.Зарегистрировано = 0, 0, Окр(100 * Итог.Значение / Данные.Зарегистрировано, 1));
		ТекстДоли = Формат(Доля, "ЧДЦ=1; ЧН=0,0") + " %";
		Таблица.Область(СтрокаДокумента, 3).Текст = ТекстДоли;
		Серия = ДиаграммаОтчета.Серии.Добавить(Подпись + ": " + Строка(Итог.Значение) + " (" + ТекстДоли + ")");
		ДиаграммаОтчета.УстановитьЗначение(Точка, Серия, Итог.Значение);
	КонецЦикла;
	Таблица.Область("R9C1").Текст = "Участник";
	Таблица.Область("R9C2").Текст = "Отметка";
	Таблица.Область("R9C1").ШиринаКолонки = 44;
	Таблица.Область("R9C2").ШиринаКолонки = 20;
	Таблица.Область("R9C1:R9C2").ЦветФона = Новый Цвет(224, 236, 243);
	СтрокаДокумента = 9;
	Для Каждого СтрокаОтчета Из Данные.Строки Цикл
		СтрокаДокумента = СтрокаДокумента + 1;
		Таблица.Область(СтрокаДокумента, 1).Текст = Строка(СтрокаОтчета.Участник);
		Таблица.Область(СтрокаДокумента, 2).Текст = ?(ЗначениеЗаполнено(СтрокаОтчета.Отметка), Строка(СтрокаОтчета.Отметка), "Без отметки");
	КонецЦикла;
	РезультатОтчета = Таблица;
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьТаблица(Команда)
	Элементы.РезультатОтчета.Видимость = Истина;
	Элементы.ДиаграммаОтчета.Видимость = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьДиаграмма(Команда)
	Элементы.РезультатОтчета.Видимость = Ложь;
	Элементы.ДиаграммаОтчета.Видимость = Истина;
КонецПроцедуры
