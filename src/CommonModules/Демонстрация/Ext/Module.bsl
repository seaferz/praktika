		"ВЫБРАТЬ ПЕРВЫЕ 1 М.Ссылка ИЗ Документ.Мероприятие КАК М
		|ГДЕ М.Название = &Название И М.Начало = &Начало И М.Площадка = &Площадка",
		Новый Структура("Название,Начало,Площадка", Мероприятие.Название, Мероприятие.Начало, Мероприятие.Площадка));
	Возврат События.Количество() > 0;
КонецФункции

Процедура ПроверитьПредставленияИВыбор(Журнал)
	М = ПримерМероприятия();
	Текст = Строка(М);
	Проверить(СтрНайти(Текст, М.Название) > 0 И СтрНайти(Текст, "07.11.2026 10:00") > 0,
		"В представлении события должны быть название и дата начала");
	Проверить(СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку("[Имя] / [Место]",
		Новый Структура("Имя,Место", "Кубок 100%", "Манеж")) = "Кубок 100% / Манеж", "Шаблон БСП");
	Журнал.Добавить("PASS | 13. Представление мероприятия содержит название и время, подстановка БСП сохраняет спецсимволы.");

	Занятые = Новый Соответствие;
	Занятые.Вставить(Справочники.Спортсмены.НайтиПоКоду("ДЕМО-01"), Истина);
	Доступные = СпортивныеПравила.ВариантыУчастников(М, Истина, Занятые);
	Проверить(Доступные.Количество() = 2, "В протоколе перечисляются незанятые строки из проведенных регистраций");
	Для Каждого Участник Из Доступные Цикл
		Проверить(ТипЗнч(Участник.Значение) = Тип("СправочникСсылка.Спортсмены"), "Личные участники");
	КонецЦикла;
	Доступные = СпортивныеПравила.ВариантыУчастников(М, Ложь, Новый Соответствие);
	Проверить(Доступные.Количество() = 2, "В регистрации доступны новые спортсмены подходящего вида спорта");
	Журнал.Добавить("PASS | 14. Варианты выбора фильтруются по виду спорта, регистрации и заполненным строкам.");
КонецПроцедуры

Функция ДобавитьПримерыОборудования()
	Изменено = НазначитьПримерОборудования("Кубок «Олимпа» по армрестлингу", "ДЕМО-01", 1);
	Изменено = НазначитьПримерОборудования("Кубок «Рубежа» по прыжкам в длину", "ДЕМО-10", 1) Или Изменено;
	Изменено = НазначитьПримерОборудования("Командный кубок «Маяка»", "ДЕМО-09", 2) Или Изменено;
	Возврат Изменено;
КонецФункции

Функция НазначитьПримерОборудования(Название, Код, Количество)
	Позиция = Справочники.Оборудование.НайтиПоКоду(Код);
	Если Не ЗначениеЗаполнено(Позиция) Или Позиция.ПометкаУдаления Или Позиция.Количество < Количество
		Или Позиция.Состояние <> Перечисления.СостоянияОборудования.Исправно Тогда
		Возврат Ложь;
	КонецЕсли;
	Таблица = СпортивныеПравила.ТаблицаЗапроса(
		"ВЫБРАТЬ М.Ссылка КАК Мероприятие ИЗ Документ.Мероприятие КАК М
		|ГДЕ М.Название = &Название И М.Площадка = &Площадка И М.Проведен И НЕ М.ПометкаУдаления
		| И М.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыМероприятий.Отменено)",
		Новый Структура("Название,Площадка", Название, Позиция.Площадка));
	Если Таблица.Количество() <> 1 Тогда
		Возврат Ложь;
	КонецЕсли;
	Мероприятие = Таблица[0].Мероприятие.ПолучитьОбъект();
	Если Мероприятие.Оборудование.Количество() > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Строка = Мероприятие.Оборудование.Добавить();
	Строка.Оборудование = Позиция;
	Строка.Количество = Количество;
	Мероприятие.Записать(РежимЗаписиДокумента.Проведение);
	Возврат Истина;
КонецФункции

Процедура ПроверитьУчетОборудования(Журнал)
	Пример = ПримерМероприятия();
	Стол = Справочники.Оборудование.НайтиПоКоду("ДЕМО-01");
	Весы = Справочники.Оборудование.НайтиПоКоду("ДЕМО-12");
	Доступные = СпортивныеПравила.ВариантыОборудования(Весы.Площадка, Новый Соответствие);
	Проверить(Доступные.Количество() = 1 И Доступные.НайтиПоЗначению(Весы) = Неопределено, "Подбор скрывает неисправное оборудование");
	Проверить(Пример.ПолучитьОбъект().Оборудование.Количество() = 1, "Оборудование в демонстрационном мероприятии");

	М = НовоеМероприятие("Испытание оборудования", Пример.ВидСпорта, Пример.Площадка,
		Пример.Окончание + 3600, Пример.Окончание + 5400, Пример.Формат, 5);
	Режим = РежимЗаписиДокумента.Проведение;
	Строка = М.Оборудование.Добавить();
	Строка.Оборудование = Весы;
	Строка.Количество = 1;
	ДолженОтклониться(М, Режим, "исправное оборудование");
	Строка.Оборудование = Стол;
	Строка.Количество = Стол.Количество + 1;
	ДолженОтклониться(М, Режим, "Количество должно быть");
	Строка.Количество = 1;
	Дубль = М.Оборудование.Добавить();
	Дубль.Оборудование = Стол;
	Дубль.Количество = 1;
	ДолженОтклониться(М, Режим, "Оборудование уже добавлено");
	М.Оборудование.Удалить(Дубль);
	М.Записать(Режим);
	Сохранено = М.Ссылка.ПолучитьОбъект().Оборудование;
	Проверить(Сохранено.Количество() = 1 И Сохранено[0].Оборудование = Стол И Сохранено[0].Количество = 1,
		"Корректное оборудование записано при проведении");
	М.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	Журнал.Добавить("PASS | 15. Оборудование выбирается по площадке, проверяются исправность, количество и дубли, корректная строка сохранена.");
КонецПроцедуры
