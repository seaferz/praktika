&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	СформироватьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	СформироватьНаСервере();
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
	Отборы = Новый Структура("НачалоПериода,КонецПериода,СпортивныйОбъект,Площадка,ВидСпорта,Статус", НачалоПериода, КонецПериода, СпортивныйОбъект, Площадка, ВидСпорта, Статус);
	Если ЗначениеЗаполнено(НачалоПериода) И ЗначениеЗаполнено(КонецПериода) И НачалоПериода > КонецПериода Тогда
		ДиаграммаОтчета.Очистить();
		РезультатОтчета = СпортивныеОтчеты.Сформировать("ЗагрузкаПлощадок", Отборы);
		ПоказатьТаблицуНаСервере();
		Возврат;
	КонецЕсли;
	Строки = СпортивныеОтчеты.Данные("ЗагрузкаПлощадок", Отборы);
	РезультатОтчета = СпортивныеОтчеты.Сформировать("ЗагрузкаПлощадок", Отборы, Строки);
	СпортивныеОтчеты.ЗаполнитьДиаграмму(ДиаграммаОтчета, Строки, "ЗагрузкаПлощадок");
КонецПроцедуры

&НаСервере
Процедура ПоказатьТаблицуНаСервере()
	Элементы.РезультатОтчета.Видимость = Истина;
	Элементы.ДиаграммаОтчета.Видимость = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьТаблица(Команда)
	Элементы.РезультатОтчета.Видимость = Истина;
	Элементы.ДиаграммаОтчета.Видимость = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьДиаграмма(Команда)
	Элементы.РезультатОтчета.Видимость = Ложь;
	Элементы.ДиаграммаОтчета.Видимость = Истина;
КонецПроцедуры
