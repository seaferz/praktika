&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Элементы.НовоеМероприятие.Видимость = ПравоДоступа("ИнтерактивноеДобавление", Метаданные.Документы.Мероприятие);
	Элементы.НоваяРегистрация.Видимость = ПравоДоступа("ИнтерактивноеДобавление", Метаданные.Документы.Регистрация);
	Элементы.НовыйПротокол.Видимость = ПравоДоступа("ИнтерактивноеДобавление", Метаданные.Документы.Протокол);
	Элементы.Документы.Видимость = Элементы.НовоеМероприятие.Видимость Или Элементы.НоваяРегистрация.Видимость
		Или Элементы.НовыйПротокол.Видимость;
	ЗагрузитьРасписание();
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьРасписание()
	Результат = СпортивныеПравила.ТаблицаЗапроса(
		"ВЫБРАТЬ ПЕРВЫЕ 8
		|	М.Ссылка КАК Ссылка,
		|	М.Начало КАК Начало,
		|	М.Название КАК Название,
		|	М.Площадка КАК Площадка,
		|	М.ВидСпорта КАК ВидСпорта,
		|	М.Статус КАК Статус
		|ИЗ Документ.Мероприятие КАК М
		|ГДЕ М.Проведен И НЕ М.ПометкаУдаления И М.Окончание > &ТекущееВремя
		|	И М.Статус В (ЗНАЧЕНИЕ(Перечисление.СтатусыМероприятий.Запланировано),
		|		ЗНАЧЕНИЕ(Перечисление.СтатусыМероприятий.РегистрацияЗакрыта))
		|УПОРЯДОЧИТЬ ПО Начало, Название, Ссылка",
		Новый Структура("ТекущееВремя", ТекущаяДатаСеанса()));
	ЗначениеВРеквизитФормы(Результат, "Расписание");
	ЕстьМероприятия = Результат.Количество() > 0;
	Элементы.Расписание.Видимость = ЕстьМероприятия;
	Элементы.ОткрытьМероприятие.Доступность = ЕстьМероприятия;
	Элементы.НетМероприятий.Видимость = Не ЕстьМероприятия;
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	ЗагрузитьРасписание();
КонецПроцедуры

&НаКлиенте
Процедура РасписаниеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОткрытьТекущееМероприятие();
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьМероприятие(Команда)
	ОткрытьТекущееМероприятие();
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьТекущееМероприятие()
	СтрокаРасписания = Элементы.Расписание.ТекущиеДанные;
	Если СтрокаРасписания <> Неопределено Тогда
		ОткрытьФорму("Документ.Мероприятие.Форма.ФормаДокумента", Новый Структура("Ключ", СтрокаРасписания.Ссылка));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НовоеМероприятие(Команда)
	ОткрытьФорму("Документ.Мероприятие.Форма.ФормаДокумента");
КонецПроцедуры

&НаКлиенте
Процедура НоваяРегистрация(Команда)
	ОткрытьФорму("Документ.Регистрация.Форма.ФормаДокумента");
КонецПроцедуры

&НаКлиенте
Процедура НовыйПротокол(Команда)
	ОткрытьФорму("Документ.Протокол.Форма.ФормаДокумента");
КонецПроцедуры

&НаКлиенте
Процедура Календарь(Команда)
	ОткрытьФорму("Отчет.Календарь.Форма.ФормаОтчета");
КонецПроцедуры

&НаКлиенте
Процедура Загрузка(Команда)
	ОткрытьФорму("Отчет.ЗагрузкаПлощадок.Форма.ФормаОтчета");
КонецПроцедуры

&НаКлиенте
Процедура Рейтинг(Команда)
	ОткрытьФорму("Отчет.РейтингСпортсменов.Форма.ФормаОтчета");
КонецПроцедуры
