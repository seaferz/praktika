Перем ЗаписьСтатусаИзПротокола;

Процедура УстановитьСтатусИзПротокола(НовыйСтатус) Экспорт
	ЗаписьСтатусаИзПротокола = Истина;
	Статус = НовыйСтатус;
	Записать(РежимЗаписиДокумента.Запись);
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ЗаписьСтатусаИзПротокола = Истина Тогда
		// Протокол передает считанный под блокировкой объект и меняет только статус.
		ЗаписьСтатусаИзПротокола = Ложь;
		Возврат;
	КонецЕсли;
	Если Проведен И РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
		СпортивныеПравила.ОшибкаПроверки("Проведенный документ сохраняется с перепроведением.",
			ЭтотОбъект, "", Отказ);
		Возврат;
	КонецЕсли;
	СпортивныеПравила.Заблокировать("Документ.Мероприятие", Ссылка);

	Если РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;
	Для Каждого ИмяПоля Из СтрРазделить("Название,ВидСпорта,Организатор,Начало,Окончание,Площадка,Формат,Лимит,Статус", ",") Цикл
		ЗначениеПоля = ЭтотОбъект[ИмяПоля];
		Если Не ЗначениеЗаполнено(ЗначениеПоля)
			Или (ТипЗнч(ЗначениеПоля) = Тип("Строка") И ПустаяСтрока(ЗначениеПоля)) Тогда
			МеткаПоля = Метаданные().Реквизиты.Найти(ИмяПоля).Синоним;
			СпортивныеПравила.ОшибкаПроверки(СтрШаблон("Заполните поле «%1».", МеткаПоля), ЭтотОбъект, ИмяПоля, Отказ);
		КонецЕсли;
	КонецЦикла;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	Если Начало >= Окончание Тогда
		СпортивныеПравила.ОшибкаПроверки("Окончание должно быть позже начала.", ЭтотОбъект, "Окончание", Отказ);
		Возврат;
	КонецЕсли;
	Если Статус <> Перечисления.СтатусыМероприятий.Отменено Тогда
		Если Площадка.ПометкаУдаления Или Площадка.ВыведенаИзЭксплуатации Тогда
			СпортивныеПравила.ОшибкаПроверки("Эта площадка недоступна. Выберите действующую площадку.", ЭтотОбъект, "Площадка", Отказ);
		ИначеЕсли Лимит > Площадка.Вместимость Тогда
			СпортивныеПравила.ОшибкаПроверки("Лимит участников превышает вместимость площадки.", ЭтотОбъект, "Лимит", Отказ);
		КонецЕсли;
		ПроверитьОборудование(Отказ);
	КонецЕсли;
	Учет = СпортивныеПравила.Участники(Ссылка);
	Протокол = СпортивныеПравила.Протокол(Ссылка);
	Если Лимит < Учет.Количество() Тогда
		СпортивныеПравила.ОшибкаПроверки("Лимит меньше количества зарегистрированных участников.", ЭтотОбъект, "Лимит", Отказ);
	КонецЕсли;
	Если Учет.Количество() > 0 И (Формат <> Ссылка.Формат Или ВидСпорта <> Ссылка.ВидСпорта) Тогда
		СпортивныеПравила.ОшибкаПроверки("Снимите регистрации перед изменением вида спорта или формата.",
			ЭтотОбъект, "Формат", Отказ);
	КонецЕсли;
	Для Каждого СтрокаУчета Из Учет Цикл
		Если НачалоДня(Начало) < НачалоДня(СтрокаУчета.ДатаРегистрации) Тогда
			СпортивныеПравила.ОшибкаПроверки("Начало мероприятия раньше даты действующей регистрации.",
				ЭтотОбъект, "Начало", Отказ);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(Протокол) Тогда
		Если Начало <> Ссылка.Начало Или Окончание <> Ссылка.Окончание Или Площадка <> Ссылка.Площадка Тогда
			СпортивныеПравила.ОшибкаПроверки("Снимите проведение протокола перед изменением времени или площадки.",
				ЭтотОбъект, "Начало", Отказ);
		КонецЕсли;
		Если Статус = Перечисления.СтатусыМероприятий.Запланировано Тогда
			СпортивныеПравила.ОшибкаПроверки("Снимите проведение протокола перед открытием регистрации.",
				ЭтотОбъект, "Статус", Отказ);
		КонецЕсли;
	ИначеЕсли Статус = Перечисления.СтатусыМероприятий.Завершено Тогда
		СпортивныеПравила.ОшибкаПроверки("Для завершения мероприятия проведите итоговый протокол.",
			ЭтотОбъект, "Статус", Отказ);
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Движения.БронированияПлощадок.Записывать = Истина;
	Движения.БронированияПлощадок.Очистить();
	Если Статус = Перечисления.СтатусыМероприятий.Отменено Тогда
		Возврат;
	КонецЕсли;
	СпортивныеПравила.Заблокировать("Справочник.Площадки", Площадка);
	Конфликт = СпортивныеПравила.Пересечение(Площадка, Начало, Окончание, Ссылка);
	Если Конфликт <> Неопределено Тогда
		Текст = СтрШаблон("Площадка занята мероприятием «%1» с %2 по %3. Выберите другое время или площадку.",
			Конфликт.Название, Формат(Конфликт.Начало, "ДФ='dd.MM.yyyy HH:mm'"), Формат(Конфликт.Окончание, "ДФ='dd.MM.yyyy HH:mm'"));
		СпортивныеПравила.ОшибкаПроверки(Текст, ЭтотОбъект, "Площадка", Отказ);
		Возврат;
	КонецЕсли;
	Запись = Движения.БронированияПлощадок.Добавить();
	Запись.Площадка = Площадка;
	Запись.Мероприятие = Ссылка;
	Запись.Начало = Начало;
	Запись.Окончание = Окончание;
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	СпортивныеПравила.Заблокировать("Документ.Мероприятие", Ссылка);
	Если СпортивныеПравила.Участники(Ссылка).Количество() > 0 Или ЗначениеЗаполнено(СпортивныеПравила.Протокол(Ссылка)) Тогда
		СпортивныеПравила.ОшибкаПроверки("Есть проведенные регистрации или протокол. Для отмены установите статус «Отменено» и проведите мероприятие.",
			ЭтотОбъект, "Статус", Отказ);
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьОборудование(Отказ)
	Выбранное = Новый Соответствие;
	Позиции = Новый СписокЗначений;
	Для Каждого СтрокаОборудования Из Оборудование Цикл
		Позиция = СтрокаОборудования.Оборудование;
		Если ЗначениеЗаполнено(Позиция) И Позиции.НайтиПоЗначению(Позиция) = Неопределено Тогда
			Позиции.Добавить(Позиция, Строка(Позиция.УникальныйИдентификатор()));
		КонецЕсли;
	КонецЦикла;
	Позиции.СортироватьПоПредставлению();
	Для Каждого ЭлементСписка Из Позиции Цикл
		СпортивныеПравила.Заблокировать("Справочник.Оборудование", ЭлементСписка.Значение);
	КонецЦикла;

	Для Каждого СтрокаОборудования Из Оборудование Цикл
		Путь = СтрШаблон("Оборудование[%1].", СтрокаОборудования.НомерСтроки - 1);
		Позиция = СтрокаОборудования.Оборудование;
		Если Не ЗначениеЗаполнено(Позиция) Тогда
			СпортивныеПравила.ОшибкаПроверки("Выберите оборудование в строке.", ЭтотОбъект, Путь + "Оборудование", Отказ);
		ИначеЕсли Позиция.ПометкаУдаления Или Позиция.ВидСпорта <> ВидСпорта
			Или Позиция.Состояние <> Перечисления.СостоянияОборудования.Исправно Тогда
			СпортивныеПравила.ОшибкаПроверки("Выберите исправное оборудование для вида спорта мероприятия.",
				ЭтотОбъект, Путь + "Оборудование", Отказ);
		ИначеЕсли Выбранное.Получить(Позиция) <> Неопределено Тогда
			СпортивныеПравила.ОшибкаПроверки("Оборудование уже добавлено. Укажите общее количество в одной строке.",
				ЭтотОбъект, Путь + "Оборудование", Отказ);
		ИначеЕсли СтрокаОборудования.Количество < 1 Или СтрокаОборудования.Количество > Позиция.Количество Тогда
			СпортивныеПравила.ОшибкаПроверки(СтрШаблон("Количество должно быть от 1 до %1.", Позиция.Количество),
				ЭтотОбъект, Путь + "Количество", Отказ);
		Иначе
			Выбранное.Вставить(Позиция, Истина);
			Доступно = СпортивныеПравила.ДоступноеКоличествоОборудования(Позиция, Позиция.Количество, Начало, Окончание, Ссылка);
			Если СтрокаОборудования.Количество > Доступно Тогда
				Текст = СтрШаблон("Оборудование «%1» занято на других мероприятиях. На этот интервал доступно: %2.",
					Позиция, Доступно);
				СпортивныеПравила.ОшибкаПроверки(Текст, ЭтотОбъект, Путь + "Количество", Отказ);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
