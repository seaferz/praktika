Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Поля.Добавить("Название");
	Поля.Добавить("Начало");
	Поля.Добавить("Дата");
	Поля.Добавить("Номер");
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	Если ПустаяСтрока(Данные.Название) Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	ДатаПоказа = ?(ЗначениеЗаполнено(Данные.Начало), Данные.Начало, Данные.Дата);
	Параметры = Новый Структура("Когда,Название", Формат(ДатаПоказа, "ДФ='dd.MM.yyyy HH:mm'"), Данные.Название);
	Представление = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку("[Название] ([Когда])", Параметры);
КонецПроцедуры
