&НаКлиенте
Процедура УчастникНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если Не ЗначениеЗаполнено(Объект.Мероприятие) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сначала выберите мероприятие.", , "Объект.Мероприятие");
		Возврат;
	КонецЕсли;
	ТекущаяСтрока = Элементы.Участники.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ВыбратьУчастника(Элемент, ТекущаяСтрока.ПолучитьИдентификатор(), Объект.Мероприятие);
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВыбратьУчастника(Элемент, Идентификатор, Мероприятие)
	Список = СписокУчастниковНаСервере(Идентификатор);
	Если Список.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет доступных участников по выбранному виду спорта. Проверьте справочник и уже проведенные регистрации.");
		Возврат;
	КонецЕсли;
	Выбор = Ждать ВыбратьИзСпискаАсинх(Список, Элемент);
	Если Выбор = Неопределено Или Мероприятие <> Объект.Мероприятие Тогда
		Возврат;
	КонецЕсли;
	СтрокаВыбора = Объект.Участники.НайтиПоИдентификатору(Идентификатор);
	Если СтрокаВыбора <> Неопределено Тогда
		СтрокаВыбора.Участник = Выбор.Значение;
		Модифицированность = Истина;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция СписокУчастниковНаСервере(Идентификатор)
	Занятые = Новый Соответствие;
	Для Каждого СтрокаТаблицы Из Объект.Участники Цикл
		Если СтрокаТаблицы.ПолучитьИдентификатор() <> Идентификатор Тогда
			Занятые.Вставить(СтрокаТаблицы.Участник, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат СпортивныеПравила.ВариантыУчастников(Объект.Мероприятие, Ложь, Занятые, Объект.Ссылка);
КонецФункции
