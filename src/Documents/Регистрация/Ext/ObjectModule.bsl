Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если Проведен И РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
		СпортивныеПравила.ОшибкаПроверки("Проведенный документ сохраняется с перепроведением.",
			ЭтотОбъект, "", Отказ);
		Возврат;
	КонецЕсли;
	СпортивныеПравила.ПроверитьИсходныйУчет(ЭтотОбъект, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		СпортивныеПравила.Заблокировать("Документ.Мероприятие", Мероприятие);
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Если Не ЗначениеЗаполнено(Мероприятие) Или Не Мероприятие.Проведен Или Мероприятие.ПометкаУдаления Тогда
		СпортивныеПравила.ОшибкаПроверки("Выберите проведенное мероприятие.", ЭтотОбъект, "Мероприятие", Отказ);
		Возврат;
	КонецЕсли;
	Если Мероприятие.Статус <> Перечисления.СтатусыМероприятий.Запланировано Тогда
		Текст = СтрШаблон("Регистрация закрыта. Статус мероприятия «%1». Заявки принимаются в статусе «Запланировано».",
			Мероприятие.Статус);
		СпортивныеПравила.ОшибкаПроверки(Текст, ЭтотОбъект, "Мероприятие", Отказ);
		Возврат;
	КонецЕсли;
	Если НачалоДня(Дата) > НачалоДня(Мероприятие.Начало) Тогда
		Текст = СтрШаблон("Дата регистрации позже дня начала мероприятия (%1). Укажите дату в день начала или раньше.",
			Формат(Мероприятие.Начало, "ДФ=dd.MM.yyyy"));
		СпортивныеПравила.ОшибкаПроверки(Текст, ЭтотОбъект, "Дата", Отказ);
		Возврат;
	КонецЕсли;
	Если Участники.Количество() = 0 Тогда
		СпортивныеПравила.ОшибкаПроверки("Добавьте хотя бы одного участника.", ЭтотОбъект, "Участники", Отказ);
		Возврат;
	КонецЕсли;
	Учет = СпортивныеПравила.Участники(Мероприятие, Ссылка);
	Если Учет.Количество() + Участники.Количество() > Мероприятие.Лимит Тогда
		СпортивныеПравила.ОшибкаПроверки(СтрШаблон("Превышен лимит участников (%1). Уже зарегистрировано: %2.",
			Мероприятие.Лимит, Учет.Количество()), ЭтотОбъект, "Участники", Отказ);
		Возврат;
	КонецЕсли;
	Занятые = Новый Соответствие;
	Для Каждого СтрокаУчета Из Учет Цикл
		Занятые.Вставить(СтрокаУчета.Участник, Истина);
	КонецЦикла;
	Движения.ЗарегистрированныеУчастники.Записывать = Истина;
	Движения.ЗарегистрированныеУчастники.Очистить();
	Для Каждого СтрокаУчастника Из Участники Цикл
		Участник = СтрокаУчастника.Участник;
		Поле = СтрШаблон("Участники[%1].Участник", СтрокаУчастника.НомерСтроки - 1);
		Если Не СпортивныеПравила.ПодходитУчастник(Участник, Мероприятие.ВидСпорта, Мероприятие.Формат) Тогда
			СпортивныеПравила.ОшибкаПроверки("Участник должен быть действующим и соответствовать формату и виду спорта мероприятия.",
				ЭтотОбъект, Поле, Отказ);
			Возврат;
		КонецЕсли;
		Если Занятые.Получить(Участник) <> Неопределено Тогда
			СпортивныеПравила.ОшибкаПроверки(СтрШаблон("Участник «%1» уже зарегистрирован на это мероприятие.", Участник),
				ЭтотОбъект, Поле, Отказ);
			Возврат;
		КонецЕсли;
		Занятые.Вставить(Участник, Истина);
		Запись = Движения.ЗарегистрированныеУчастники.Добавить();
		Запись.Мероприятие = Мероприятие;
		Запись.Участник = Участник;
	КонецЦикла;
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	СпортивныеПравила.Заблокировать("Документ.Мероприятие", Мероприятие);
	Если ЗначениеЗаполнено(СпортивныеПравила.Протокол(Мероприятие)) Тогда
		СпортивныеПравила.ОшибкаПроверки("Сначала снимите проведение итогового протокола. Он использует список зарегистрированных участников.",
			ЭтотОбъект, "Мероприятие", Отказ);
	КонецЕсли;
КонецПроцедуры
