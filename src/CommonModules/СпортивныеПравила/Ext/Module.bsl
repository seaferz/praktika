Процедура ОшибкаПроверки(Текст, Объект, Поле, Отказ) Экспорт
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, Объект, Поле, , Отказ);
КонецПроцедуры

Процедура Заблокировать(Пространство, Ссылка) Экспорт
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить(Пространство);
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение("Ссылка", Ссылка);
	Блокировка.Заблокировать();
КонецПроцедуры

Функция ТаблицаЗапроса(Текст, Параметры) Экспорт
	Запрос = Новый Запрос(Текст);
	Для Каждого Параметр Из Параметры Цикл
		Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция Пересечение(Площадка, Начало, Окончание, Исключить) Экспорт
	Таблица = ТаблицаЗапроса(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Б.Регистратор КАК Мероприятие,
		| Б.Регистратор.Название КАК Название, Б.Начало КАК Начало, Б.Окончание КАК Окончание
		|ИЗ РегистрСведений.БронированияПлощадок КАК Б
		|ГДЕ Б.Площадка = &Площадка И Б.Начало < &Окончание И Б.Окончание > &Начало
		| И Б.Регистратор <> &Исключить
		|УПОРЯДОЧИТЬ ПО Б.Начало",
		Новый Структура("Площадка,Начало,Окончание,Исключить", Площадка, Начало, Окончание, Исключить));
	Возврат ?(Таблица.Количество() = 0, Неопределено, Таблица[0]);
КонецФункции

Функция Участники(Мероприятие, Исключить = Неопределено) Экспорт
	Если Исключить = Неопределено Тогда
		Исключить = Документы.Регистрация.ПустаяСсылка();
	КонецЕсли;
	Возврат ТаблицаЗапроса(
		"ВЫБРАТЬ У.Участник КАК Участник, У.Регистратор КАК Регистрация,
		| У.Регистратор.Дата КАК ДатаРегистрации
		|ИЗ РегистрСведений.ЗарегистрированныеУчастники КАК У
		|ГДЕ У.Мероприятие = &Мероприятие И У.Регистратор <> &Исключить
		|УПОРЯДОЧИТЬ ПО У.Регистратор.Дата, У.НомерСтроки",
		Новый Структура("Мероприятие,Исключить", Мероприятие, Исключить));
КонецФункции

Функция Протокол(Мероприятие, Исключить = Неопределено) Экспорт
	Если Исключить = Неопределено Тогда
		Исключить = Документы.Протокол.ПустаяСсылка();
	КонецЕсли;
	Таблица = ТаблицаЗапроса(
		"ВЫБРАТЬ ПЕРВЫЕ 1 П.Ссылка КАК Ссылка
		|ИЗ Документ.Протокол КАК П
		|ГДЕ П.Мероприятие = &Мероприятие И П.Проведен И П.Ссылка <> &Исключить",
		Новый Структура("Мероприятие,Исключить", Мероприятие, Исключить));
	Возврат ?(Таблица.Количество() = 0, Документы.Протокол.ПустаяСсылка(), Таблица[0].Ссылка);
КонецФункции

Функция ПодходитУчастник(Участник, ВидСпорта, Формат) Экспорт
	Если Не ЗначениеЗаполнено(Участник) Тогда
		Возврат Ложь;
	КонецЕсли;
	НужныйТип = ?(Формат = Перечисления.ФорматыСоревнований.Личный,
		Тип("СправочникСсылка.Спортсмены"), Тип("СправочникСсылка.Команды"));
	Возврат ТипЗнч(Участник) = НужныйТип И Не Участник.ПометкаУдаления И Участник.ВидСпорта = ВидСпорта;
КонецФункции

Процедура ПроверитьИсходныйУчет(ДокументОбъект, Отказ) Экспорт
	Если ДокументОбъект.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	СтароеМероприятие = ДокументОбъект.Ссылка.Мероприятие;
	Если СтароеМероприятие <> ДокументОбъект.Мероприятие Тогда
		ОшибкаПроверки("Мероприятие уже записанного документа фиксировано. Для другого мероприятия создайте новый документ.",
			ДокументОбъект, "Мероприятие", Отказ);
	КонецЕсли;
КонецПроцедуры

Процедура РассчитатьМеста(Таблица, Показатель) Экспорт
	Ранжирование = Новый ТаблицаЗначений;
	Ранжирование.Колонки.Добавить("СтрокаРезультата");
	Ранжирование.Колонки.Добавить("Результат");
	Для Каждого СтрокаРезультата Из Таблица Цикл
		СтрокаРанжирования = Ранжирование.Добавить();
		СтрокаРанжирования.СтрокаРезультата = СтрокаРезультата;
		СтрокаРанжирования.Результат = СтрокаРезультата.Результат;
	КонецЦикла;
	Ранжирование.Сортировать(?(Показатель = Перечисления.ПоказателиРезультата.Время,
		"Результат Возр", "Результат Убыв"));
	Позиция = 0;
	Место = 0;
	ПрошлыйРезультат = Неопределено;
	Для Каждого СтрокаРанжирования Из Ранжирование Цикл
		Позиция = Позиция + 1;
		Если СтрокаРанжирования.Результат <> ПрошлыйРезультат Тогда
			Место = Позиция;
			ПрошлыйРезультат = СтрокаРанжирования.Результат;
		КонецЕсли;
		СтрокаРезультата = СтрокаРанжирования.СтрокаРезультата;
		СтрокаРезультата.Место = ?(СтрокаРезультата.МестоВручную > 0, СтрокаРезультата.МестоВручную, Место);
	КонецЦикла;
КонецПроцедуры
