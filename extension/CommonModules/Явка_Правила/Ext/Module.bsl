
Функция Действует(Мероприятие) Экспорт
	Возврат ЗначениеЗаполнено(Мероприятие) И Мероприятие.Проведен И Не Мероприятие.ПометкаУдаления
		И Мероприятие.Статус <> Перечисления.СтатусыМероприятий.Отменено;
КонецФункции

Функция ДокументЯвки(Мероприятие, Исключить = Неопределено) Экспорт
	Если Исключить = Неопределено Тогда
		Исключить = Документы.Явка_УчетЯвки.ПустаяСсылка();
	КонецЕсли;
	Результат = СпортивныеПравила.ТаблицаЗапроса(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Я.Ссылка КАК Ссылка
		|ИЗ Документ.Явка_УчетЯвки КАК Я
		|ГДЕ Я.Мероприятие = &Мероприятие И Я.Проведен
		| И Я.Ссылка <> &Исключить",
		Новый Структура("Мероприятие,Исключить", Мероприятие, Исключить));
	Возврат ?(Результат.Количество() = 0, Документы.Явка_УчетЯвки.ПустаяСсылка(), Результат[0].Ссылка);
КонецФункции

Функция ДанныеОтчета(Мероприятие) Экспорт
	Данные = Новый Структура("Строки,Зарегистрировано,Явились,НеЯвились,БезОтметки", Новый ТаблицаЗначений, 0, 0, 0, 0);
	Если Не Действует(Мероприятие) Тогда
		Возврат Данные;
	КонецЕсли;
	Данные.Строки = СпортивныеПравила.ТаблицаЗапроса(
		"ВЫБРАТЬ Р.Участник КАК Участник, Я.Отметка КАК Отметка
		|ИЗ РегистрСведений.ЗарегистрированныеУчастники КАК Р
		| ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Явка_ОтметкиУчастников КАК Я
		| ПО Я.Мероприятие = Р.Мероприятие И Я.Участник = Р.Участник
		|ГДЕ Р.Мероприятие = &Мероприятие
		|УПОРЯДОЧИТЬ ПО Р.Участник",
		Новый Структура("Мероприятие", Мероприятие));
	Данные.Зарегистрировано = Данные.Строки.Количество();
	Для Каждого СтрокаОтчета Из Данные.Строки Цикл
		Если СтрокаОтчета.Отметка = Перечисления.Явка_Отметки.Явился Тогда
			Данные.Явились = Данные.Явились + 1;
		ИначеЕсли СтрокаОтчета.Отметка = Перечисления.Явка_Отметки.НеЯвился Тогда
			Данные.НеЯвились = Данные.НеЯвились + 1;
		Иначе
			Данные.БезОтметки = Данные.БезОтметки + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Данные;
КонецФункции
