Процедура ОшибкаПроверки(Текст, Объект, Поле, Отказ) Экспорт
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, Объект, Поле, , Отказ);
КонецПроцедуры

Процедура Заблокировать(Пространство, Ссылка) Экспорт
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить(Пространство);
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение("Ссылка", Ссылка);
	Блокировка.Заблокировать();
КонецПроцедуры

Функция ТаблицаЗапроса(Текст, Параметры) Экспорт
	Запрос = Новый Запрос(Текст);
	Для Каждого Параметр Из Параметры Цикл
		Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция Пересечение(Площадка, Начало, Окончание, Исключить) Экспорт
	Таблица = ТаблицаЗапроса(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Б.Регистратор КАК Мероприятие,
		| Б.Регистратор.Название КАК Название, Б.Начало КАК Начало, Б.Окончание КАК Окончание
		|ИЗ РегистрСведений.БронированияПлощадок КАК Б
		|ГДЕ Б.Площадка = &Площадка И Б.Начало < &Окончание И Б.Окончание > &Начало
		| И Б.Регистратор <> &Исключить
		|УПОРЯДОЧИТЬ ПО Б.Начало",
		Новый Структура("Площадка,Начало,Окончание,Исключить", Площадка, Начало, Окончание, Исключить));
	Возврат ?(Таблица.Количество() = 0, Неопределено, Таблица[0]);
КонецФункции

Функция Участники(Мероприятие, Исключить = Неопределено) Экспорт
	Если Исключить = Неопределено Тогда
		Исключить = Документы.Регистрация.ПустаяСсылка();
	КонецЕсли;
	Возврат ТаблицаЗапроса(
		"ВЫБРАТЬ У.Участник КАК Участник, У.Регистратор КАК Регистрация,
		| У.Регистратор.Дата КАК ДатаРегистрации
		|ИЗ РегистрСведений.ЗарегистрированныеУчастники КАК У
		|ГДЕ У.Мероприятие = &Мероприятие И У.Регистратор <> &Исключить
		|УПОРЯДОЧИТЬ ПО У.Регистратор.Дата, У.НомерСтроки",
		Новый Структура("Мероприятие,Исключить", Мероприятие, Исключить));
КонецФункции

Функция Протокол(Мероприятие, Исключить = Неопределено) Экспорт
	Если Исключить = Неопределено Тогда
		Исключить = Документы.Протокол.ПустаяСсылка();
	КонецЕсли;
	Таблица = ТаблицаЗапроса(
		"ВЫБРАТЬ ПЕРВЫЕ 1 П.Ссылка КАК Ссылка
		|ИЗ Документ.Протокол КАК П
		|ГДЕ П.Мероприятие = &Мероприятие И П.Проведен И П.Ссылка <> &Исключить",
		Новый Структура("Мероприятие,Исключить", Мероприятие, Исключить));
	Возврат ?(Таблица.Количество() = 0, Документы.Протокол.ПустаяСсылка(), Таблица[0].Ссылка);
КонецФункции

Функция ПодходитУчастник(Участник, ВидСпорта, Формат) Экспорт
	Если Не ЗначениеЗаполнено(Участник) Тогда
		Возврат Ложь;
	КонецЕсли;
	НужныйТип = ?(Формат = Перечисления.ФорматыСоревнований.Личный,
		Тип("СправочникСсылка.Спортсмены"), Тип("СправочникСсылка.Команды"));
	Возврат ТипЗнч(Участник) = НужныйТип И Не Участник.ПометкаУдаления И Участник.ВидСпорта = ВидСпорта;
КонецФункции

Процедура ПроверитьИсходныйУчет(ДокументОбъект, Отказ) Экспорт
	Если ДокументОбъект.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	СтароеМероприятие = ДокументОбъект.Ссылка.Мероприятие;
	Если СтароеМероприятие <> ДокументОбъект.Мероприятие Тогда
		ОшибкаПроверки("Мероприятие уже записанного документа фиксировано. Для другого мероприятия создайте новый документ.",
			ДокументОбъект, "Мероприятие", Отказ);
	КонецЕсли;
КонецПроцедуры

Процедура РассчитатьМеста(Таблица, Показатель) Экспорт
	Ранжирование = Новый ТаблицаЗначений;
	Ранжирование.Колонки.Добавить("СтрокаРезультата");
	Ранжирование.Колонки.Добавить("Результат");
	Для Каждого СтрокаРезультата Из Таблица Цикл
		СтрокаРанжирования = Ранжирование.Добавить();
		СтрокаРанжирования.СтрокаРезультата = СтрокаРезультата;
		СтрокаРанжирования.Результат = СтрокаРезультата.Результат;
	КонецЦикла;
	Ранжирование.Сортировать(?(Показатель = Перечисления.ПоказателиРезультата.Время,
		"Результат Возр", "Результат Убыв"));
	Позиция = 0;
	Место = 0;
	ПрошлыйРезультат = Неопределено;
	Для Каждого СтрокаРанжирования Из Ранжирование Цикл
		Позиция = Позиция + 1;
		Если СтрокаРанжирования.Результат <> ПрошлыйРезультат Тогда
			Место = Позиция;
			ПрошлыйРезультат = СтрокаРанжирования.Результат;
		КонецЕсли;
		СтрокаРезультата = СтрокаРанжирования.СтрокаРезультата;
		СтрокаРезультата.Место = ?(СтрокаРезультата.МестоВручную > 0, СтрокаРезультата.МестоВручную, Место);
	КонецЦикла;
КонецПроцедуры

Функция ВариантыУчастников(Мероприятие, ТолькоЗарегистрированные, УжеВыбраны, Регистрация = Неопределено) Экспорт
	Список = Новый СписокЗначений;
	Если Не ЗначениеЗаполнено(Мероприятие) Тогда
		Возврат Список;
	КонецЕсли;

	Если ТолькоЗарегистрированные Тогда
		Кандидаты = Участники(Мероприятие);
	Иначе
		ИмяСправочника = ?(Мероприятие.Формат = Перечисления.ФорматыСоревнований.Командный, "Команды", "Спортсмены");
		Кандидаты = ТаблицаЗапроса(
			"ВЫБРАТЬ У.Ссылка КАК Участник ИЗ Справочник." + ИмяСправочника + " КАК У
			|ГДЕ У.ВидСпорта = &ВидСпорта И НЕ У.ПометкаУдаления
			|УПОРЯДОЧИТЬ ПО У.Наименование",
			Новый Структура("ВидСпорта", Мероприятие.ВидСпорта));
		Для Каждого СтрокаУчета Из Участники(Мероприятие, Регистрация) Цикл
			УжеВыбраны.Вставить(СтрокаУчета.Участник, Истина);
		КонецЦикла;
	КонецЕсли;

	Для Каждого Кандидат Из Кандидаты Цикл
		Если УжеВыбраны.Получить(Кандидат.Участник) = Неопределено Тогда
			Список.Добавить(Кандидат.Участник, Строка(Кандидат.Участник));
		КонецЕсли;
	КонецЦикла;
	Список.СортироватьПоПредставлению();
	Возврат Список;
КонецФункции

Функция ВариантыОборудования(ВидСпорта, Начало, Окончание, Мероприятие, УжеВыбрано) Экспорт
	Список = Новый СписокЗначений;
	Таблица = ТаблицаЗапроса(
		"ВЫБРАТЬ О.Ссылка КАК Оборудование, О.Наименование КАК Наименование,
		| О.ИнвентарныйНомер КАК ИнвентарныйНомер, О.Количество КАК Количество
		|ИЗ Справочник.Оборудование КАК О
		|ГДЕ О.ВидСпорта = &ВидСпорта И НЕ О.ПометкаУдаления И О.Количество > 0
		| И О.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияОборудования.Исправно)
		|УПОРЯДОЧИТЬ ПО О.Наименование, О.ИнвентарныйНомер",
		Новый Структура("ВидСпорта", ВидСпорта));
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если УжеВыбрано.Получить(СтрокаТаблицы.Оборудование) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Доступно = ДоступноеКоличествоОборудования(СтрокаТаблицы.Оборудование, СтрокаТаблицы.Количество, Начало, Окончание, Мероприятие);
		Если Доступно > 0 Тогда
			Представление = СтрШаблон("%1 · %2 · доступно %3",
				СтрокаТаблицы.Наименование, СтрокаТаблицы.ИнвентарныйНомер, Доступно);
			Список.Добавить(СтрокаТаблицы.Оборудование, Представление);
		КонецЕсли;
	КонецЦикла;
	Возврат Список;
КонецФункции

Функция ДоступноеКоличествоОборудования(Оборудование, Всего, Начало, Окончание, Исключить) Экспорт
	Если Не ЗначениеЗаполнено(Начало) Или Не ЗначениеЗаполнено(Окончание) Или Начало >= Окончание Тогда
		Возврат Всего;
	КонецЕсли;
	Брони = ТаблицаЗапроса(
		"ВЫБРАТЬ Б.Начало КАК Начало, Б.Окончание КАК Окончание, СТ.Количество КАК Количество
		|ИЗ Документ.Мероприятие.Оборудование КАК СТ
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.БронированияПлощадок КАК Б ПО СТ.Ссылка = Б.Мероприятие
		|ГДЕ СТ.Оборудование = &Оборудование И Б.Мероприятие <> &Исключить
		| И Б.Начало < &Окончание И Б.Окончание > &Начало",
		Новый Структура("Оборудование,Начало,Окончание,Исключить", Оборудование, Начало, Окончание, Исключить));
	Границы = Новый ТаблицаЗначений;
	Границы.Колонки.Добавить("Момент");
	Границы.Колонки.Добавить("Изменение");
	Для Каждого Бронь Из Брони Цикл
		Граница = Границы.Добавить();
		Граница.Момент = Макс(Начало, Бронь.Начало);
		Граница.Изменение = Бронь.Количество;
		Граница = Границы.Добавить();
		Граница.Момент = Мин(Окончание, Бронь.Окончание);
		Граница.Изменение = -Бронь.Количество;
	КонецЦикла;

	// При совпадении времени сначала освобождаются позиции предыдущего мероприятия.
	Границы.Сортировать("Момент Возр, Изменение Возр");
	Занято = 0;
	Пик = 0;
	Для Каждого Граница Из Границы Цикл
		Занято = Занято + Граница.Изменение;
		Пик = Макс(Пик, Занято);
	КонецЦикла;
	Возврат Макс(0, Всего - Пик);
КонецФункции
