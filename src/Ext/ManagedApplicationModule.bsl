Процедура ПриНачалеРаботыСистемы()
	ПараметрыЗапуска = СтрРазделить(ПараметрЗапуска, "|", Ложь);
	Если ПараметрыЗапуска.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Режим = ПараметрыЗапуска[0];
	Если Режим = "СпортДемо" Или Режим = "СпортТест" Или Режим = "СпортПереносОборудования"
		Или Режим = "СпортДемоЯвки" Или Режим = "СпортПользователи" Или Режим = "СпортТестЯвки" Или Режим = "СпортПрава" Тогда
		Попытка
			Если Режим = "СпортПереносОборудования" Тогда
				Итог = Демонстрация.ОбновитьВидыСпортаОборудования();
			ИначеЕсли Режим = "СпортДемоЯвки" Тогда
				Итог = Демонстрация.ПодготовитьДемонстрациюРасширения();
			ИначеЕсли Режим = "СпортПользователи" Тогда
				Итог = Демонстрация.ПодготовитьДемонстрационныхПользователей();
			ИначеЕсли Режим = "СпортТестЯвки" Тогда
				Итог = Демонстрация.ПроверитьРасширение();
			ИначеЕсли Режим = "СпортПрава" Тогда
				Итог = Демонстрация.ПроверитьДоступУчебнойРоли();
			Иначе
				Итог = ?(Режим = "СпортДемо", Демонстрация.НачальныеДанные(), Демонстрация.ЗапускПроверок());
			КонецЕсли;
		Исключение
			Итог = "ИТОГ: ОШИБКА" + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		Если ПараметрыЗапуска.Количество() > 1 Тогда
			Файл = Новый ЗаписьТекста(ПараметрыЗапуска[1], КодировкаТекста.UTF8);
			Файл.ЗаписатьСтроку(Итог);
			Файл.Закрыть();
			ЗавершитьРаботуСистемы(Ложь);
		Иначе
			Сообщить(Итог);
		КонецЕсли;
	ИначеЕсли Режим = "СпортЯвка" Или Режим = "СпортЯвкаДиаграмма" Тогда
		ИмяФормы = СтрШаблон("Отчет.%1.Форма.ФормаОтчета", "Явка_АнализЯвки");
		ОткрытьФорму(ИмяФормы,
			Новый Структура("Мероприятие,ПоказатьДиаграмму", Демонстрация.ПримерЯвки(), Режим = "СпортЯвкаДиаграмма"));
	ИначеЕсли Режим = "СпортДокументЯвки" Тогда
		ИмяФормы = СтрШаблон("Документ.%1.Форма.ФормаДокумента", "Явка_УчетЯвки");
		ОткрытьФорму(ИмяФормы,
			Новый Структура("Ключ", Демонстрация.ПоказатьПримерЯвки()));
	ИначеЕсли Режим = "СпортКалендарь" Тогда
		ОткрытьФорму("Отчет.Календарь.Форма.ФормаОтчета");
	ИначеЕсли Режим = "СпортПротокол" Тогда
		ОткрытьФорму("Отчет.ИтоговыйПротокол.Форма.ФормаОтчета",
			Новый Структура("Мероприятие", Демонстрация.ПримерМероприятия()));
	ИначеЕсли Режим = "СпортКонфликт" Тогда
		ОткрытьФорму("Документ.Мероприятие.Форма.ФормаДокумента",
			Новый Структура("Ключ", Демонстрация.ПодготовитьКонфликт()));
	КонецЕсли;
КонецПроцедуры
