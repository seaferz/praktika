&НаКлиенте
Процедура РассчитатьМеста(Команда)
	РассчитатьМестаНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьУчастников(Команда)
	ЗаполнитьУчастниковНаСервере();
КонецПроцедуры

&НаСервере
Процедура РассчитатьМестаНаСервере()
	Если Не ЗначениеЗаполнено(Объект.Мероприятие) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выберите мероприятие.", , "Объект.Мероприятие");
		Возврат;
	КонецЕсли;
	Учет = СпортивныеПравила.Участники(Объект.Мероприятие);
	Нули = СпортивныеПравила.ОпубликованныеНули(Объект.Ссылка);
	СпортивныеПравила.РассчитатьМеста(Объект.Результаты, Объект.Мероприятие.ВидСпорта.Показатель, Нули, Учет);
	Модифицированность = Истина;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьУчастниковНаСервере()
	Если Не ЗначениеЗаполнено(Объект.Мероприятие) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выберите мероприятие.", , "Объект.Мероприятие");
		Возврат;
	КонецЕсли;
	Если СпортивныеПравила.ДобавитьУчастниковПротокола(Объект.Результаты, Объект.Мероприятие) Тогда
		Модифицированность = Истина;
	ИначеЕсли Объект.Результаты.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У мероприятия нет проведенных регистраций.", , "Объект.Мероприятие");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УчастникНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если Не ЗначениеЗаполнено(Объект.Мероприятие) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сначала выберите мероприятие.", , "Объект.Мероприятие");
		Возврат;
	КонецЕсли;
	ТекущаяСтрока = Элементы.Результаты.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ВыбратьУчастника(Элемент, ТекущаяСтрока.ПолучитьИдентификатор(), Объект.Мероприятие);
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВыбратьУчастника(Элемент, Идентификатор, Мероприятие)
	Список = СписокУчастниковНаСервере(Идентификатор);
	Если Список.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("На это мероприятие нет доступных зарегистрированных участников.");
		Возврат;
	КонецЕсли;
	Выбор = Ждать ВыбратьИзСпискаАсинх(Список, Элемент);
	Если Выбор = Неопределено Или Мероприятие <> Объект.Мероприятие Тогда
		Возврат;
	КонецЕсли;
	СтрокаВыбора = Объект.Результаты.НайтиПоИдентификатору(Идентификатор);
	Если СтрокаВыбора <> Неопределено Тогда
		СтрокаВыбора.Участник = Выбор.Значение;
		Модифицированность = Истина;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция СписокУчастниковНаСервере(Идентификатор)
	Занятые = Новый Соответствие;
	Для Каждого СтрокаТаблицы Из Объект.Результаты Цикл
		Если СтрокаТаблицы.ПолучитьИдентификатор() <> Идентификатор Тогда
			Занятые.Вставить(СтрокаТаблицы.Участник, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат СпортивныеПравила.ВариантыУчастников(Объект.Мероприятие, Истина, Занятые);
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ПредыдущееМероприятие = Объект.Мероприятие;
	Элементы.ОбъектМероприятие.ТолькоПросмотр = ЗначениеЗаполнено(Объект.Ссылка)
		И ЗначениеЗаполнено(Объект.Мероприятие);
	ОбновитьКолонкиРезультатов();
КонецПроцедуры

&НаКлиенте
Асинх Процедура МероприятиеПриИзменении(Элемент)
	Если Объект.Мероприятие = ПредыдущееМероприятие Тогда
		Возврат;
	КонецЕсли;
	Если Объект.Результаты.Количество() > 0 Тогда
		Ответ = Ждать ВопросАсинх("При смене мероприятия строки результатов будут очищены. Продолжить?",
			РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Объект.Мероприятие = ПредыдущееМероприятие;
			Возврат;
		КонецЕсли;
		Объект.Результаты.Очистить();
	КонецЕсли;
	ПредыдущееМероприятие = Объект.Мероприятие;
	ОбновитьКолонкиРезультатов();
КонецПроцедуры

&НаСервере
Процедура ОбновитьКолонкиРезультатов()
	Элементы.ОбъектРезультатыНольОчков.Видимость = ЗначениеЗаполнено(Объект.Мероприятие)
		И Объект.Мероприятие.ВидСпорта.Показатель = Перечисления.ПоказателиРезультата.Очки;
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	Элементы.ОбъектМероприятие.ТолькоПросмотр = ЗначениеЗаполнено(Объект.Мероприятие);
КонецПроцедуры
