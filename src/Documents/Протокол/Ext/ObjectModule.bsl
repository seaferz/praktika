Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если Проведен И РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
		СпортивныеПравила.ОшибкаПроверки("Проведенный документ сохраняется с перепроведением.",
			ЭтотОбъект, "", Отказ);
		Возврат;
	КонецЕсли;
	СпортивныеПравила.ПроверитьИсходныйУчет(ЭтотОбъект, Отказ);
	Если Отказ Или РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Мероприятие) Тогда
		СпортивныеПравила.ОшибкаПроверки("Выберите мероприятие.", ЭтотОбъект, "Мероприятие", Отказ);
		Возврат;
	КонецЕсли;
	СпортивныеПравила.Заблокировать("Документ.Мероприятие", Мероприятие);
	Если Не Мероприятие.Проведен Или Мероприятие.ПометкаУдаления Тогда
		СпортивныеПравила.ОшибкаПроверки("Протокол оформляется только для проведенного мероприятия.", ЭтотОбъект, "Мероприятие", Отказ);
		Возврат;
	КонецЕсли;
	Если Мероприятие.Статус = Перечисления.СтатусыМероприятий.Отменено Тогда
		СпортивныеПравила.ОшибкаПроверки("Мероприятие отменено. Проведение протокола недоступно.", ЭтотОбъект, "Мероприятие", Отказ);
		Возврат;
	КонецЕсли;
	Если ТекущаяДатаСеанса() < Мероприятие.Окончание Тогда
		Текст = СтрШаблон("По расписанию мероприятие заканчивается %1. До окончания можно записать протокол как черновик. Если соревнование уже завершилось, уточните время окончания в карточке мероприятия.",
			Формат(Мероприятие.Окончание, "ДФ='dd.MM.yyyy HH:mm'"));
		СпортивныеПравила.ОшибкаПроверки(Текст, ЭтотОбъект, "Мероприятие", Отказ);
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(СпортивныеПравила.Протокол(Мероприятие, Ссылка)) Тогда
		СпортивныеПравила.ОшибкаПроверки("У мероприятия уже есть проведенный протокол. Измените существующий документ.",
			ЭтотОбъект, "Мероприятие", Отказ);
		Возврат;
	КонецЕсли;
	СпортивныеПравила.УдалитьПустыеРезультаты(Результаты);
	Если Результаты.Количество() = 0 Тогда
		СпортивныеПравила.ОшибкаПроверки("Заполните строки результата.", ЭтотОбъект, "Результаты", Отказ);
		Возврат;
	КонецЕсли;
	Показатель = Мероприятие.ВидСпорта.Показатель;
	Если Не ЗначениеЗаполнено(Показатель) Тогда
		СпортивныеПравила.ОшибкаПроверки("Для вида спорта не задан показатель результата.", ЭтотОбъект, "Мероприятие", Отказ);
		Возврат;
	КонецЕсли;
	ОпубликованныеНули = СпортивныеПравила.ОпубликованныеНули(Ссылка);
	Учет = СпортивныеПравила.Участники(Мероприятие);
	Указанные = Новый Соответствие;
	Для Каждого СтрокаРезультата Из Результаты Цикл
		Путь = СтрШаблон("Результаты[%1].", СтрокаРезультата.НомерСтроки - 1);
		Участник = СтрокаРезультата.Участник;
		Если Учет.Найти(Участник, "Участник") = Неопределено Тогда
			СпортивныеПравила.ОшибкаПроверки("В протокол можно включать только зарегистрированных участников.",
				ЭтотОбъект, Путь + "Участник", Отказ);
			Возврат;
		КонецЕсли;
		Если Указанные.Получить(Участник) <> Неопределено Тогда
			СпортивныеПравила.ОшибкаПроверки("Участник уже внесен в протокол.", ЭтотОбъект, Путь + "Участник", Отказ);
			Возврат;
		КонецЕсли;
		Указанные.Вставить(Участник, Истина);
		Если Не СпортивныеПравила.ДостигнутРезультат(СтрокаРезультата, Показатель, ОпубликованныеНули) Тогда
			Текст = ?(Показатель = Перечисления.ПоказателиРезультата.Очки,
				"Введите результат. Если участник набрал ноль, отметьте «0 очков».",
				"Введите положительный результат для времени, расстояния или веса.");
			СпортивныеПравила.ОшибкаПроверки(Текст, ЭтотОбъект, Путь + "Результат", Отказ);
			Возврат;
		КонецЕсли;
		СтрокаРезультата.НольОчков = СтрокаРезультата.Результат = 0;
		Если СтрокаРезультата.МестоВручную > Результаты.Количество()
			Или (СтрокаРезультата.МестоВручную > 0 И ПустаяСтрока(СтрокаРезультата.Причина))
			Или (СтрокаРезультата.МестоВручную = 0 И Не ПустаяСтрока(СтрокаРезультата.Причина)) Тогда
			СпортивныеПравила.ОшибкаПроверки("Укажите ручное место в пределах числа строк и заполните причину. Если корректировки нет, очистите оба поля.",
				ЭтотОбъект, Путь + "МестоВручную", Отказ);
			Возврат;
		КонецЕсли;
	КонецЦикла;
	СпортивныеПравила.РассчитатьМеста(Результаты, Показатель);
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Движения.ИтогиСоревнований.Записывать = Истина;
	Движения.ИтогиСоревнований.Очистить();
	Для Каждого СтрокаРезультата Из Результаты Цикл
		Запись = Движения.ИтогиСоревнований.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, СтрокаРезультата, "Участник,Результат,Место,МестоВручную,Причина,Примечание");
		Запись.Мероприятие = Мероприятие;
	КонецЦикла;
	ОбновитьСтатусМероприятия(Перечисления.СтатусыМероприятий.Завершено);
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	СпортивныеПравила.Заблокировать("Документ.Мероприятие", Мероприятие);
	Если Мероприятие.Статус = Перечисления.СтатусыМероприятий.Завершено Тогда
		ОбновитьСтатусМероприятия(Перечисления.СтатусыМероприятий.РегистрацияЗакрыта);
	КонецЕсли;
КонецПроцедуры

Процедура ОбновитьСтатусМероприятия(Статус)
	Если Мероприятие.Статус <> Статус Тогда
		Событие = Мероприятие.ПолучитьОбъект();
		Событие.УстановитьСтатусИзПротокола(Статус);
	КонецЕсли;
КонецПроцедуры
