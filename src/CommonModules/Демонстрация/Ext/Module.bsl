Функция НачальныеДанные() Экспорт
	Якорь = Справочники.СпортивныеОбъекты.НайтиПоКоду("ДЕМО-01");
	Если ЗначениеЗаполнено(Якорь) Тогда
		Возврат "Демонстрационный набор уже загружен.";
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		СоздатьДемонстрацию();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат "Загружено: 3 спортивных объекта, 5 площадок, 4 вида спорта, 10 спортсменов, 3 команды, 5 мероприятий.";
КонецФункции

Процедура СоздатьДемонстрацию()
	Арена = Элемент(Справочники.СпортивныеОбъекты, "ДЕМО-01", "СК «Олимп»",
		Новый Структура("Адрес", "ул. Спортивная, 14"));
	Манеж = Элемент(Справочники.СпортивныеОбъекты, "ДЕМО-02", "Манеж «Старт»",
		Новый Структура("Адрес", "проспект Мира, 8"));
	Зал = Элемент(Справочники.СпортивныеОбъекты, "ДЕМО-03", "Центр «Атлет»",
		Новый Структура("Адрес", "ул. Парковая, 22"));

	АрмЗал = Площадка("ДЕМО-01", "Зал единоборств", Арена, 30);
	ИгровойЗал = Площадка("ДЕМО-02", "Игровой зал", Арена, 12);
	Дорожка = Площадка("ДЕМО-03", "Беговая дорожка", Манеж, 48);
	Сектор = Площадка("ДЕМО-04", "Сектор прыжков", Манеж, 20);
	Помост = Площадка("ДЕМО-05", "Тяжелоатлетический помост", Зал, 16);

	Исправно = Перечисления.СостоянияОборудования.Исправно;
	Элемент(Справочники.Оборудование, "ДЕМО-01", "Стол для армрестлинга",
		Новый Структура("Площадка,ИнвентарныйНомер,Количество,Состояние", АрмЗал, "ОЛ-АРМ-01", 2, Исправно));
	Элемент(Справочники.Оборудование, "ДЕМО-02", "Электронный секундомер",
		Новый Структура("Площадка,ИнвентарныйНомер,Количество,Состояние", Дорожка, "СТ-БЕГ-01", 4, Исправно));
	Элемент(Справочники.Оборудование, "ДЕМО-03", "Комплект штанги",
		Новый Структура("Площадка,ИнвентарныйНомер,Количество,Состояние", Помост, "АТ-ТА-01", 2, Исправно));

	П = Перечисления.ПоказателиРезультата;
	Арм = ВидСпорта("ДЕМО-01", "Армрестлинг", П.Очки, "очки");
	Бег = ВидСпорта("ДЕМО-02", "Легкая атлетика: бег", П.Время, "с");
	Прыжки = ВидСпорта("ДЕМО-03", "Прыжки в длину", П.Расстояние, "м");
	Тяжелая = ВидСпорта("ДЕМО-04", "Тяжелая атлетика", П.Вес, "кг");

	ТренерАрм = Элемент(Справочники.Тренеры, "ДЕМО-01", "Орлов Илья Сергеевич", Новый Структура("ВидСпорта", Арм));
	ТренерБег = Элемент(Справочники.Тренеры, "ДЕМО-02", "Соколова Мария Андреевна", Новый Структура("ВидСпорта", Бег));
	ТренерПрыжки = Элемент(Справочники.Тренеры, "ДЕМО-03", "Крылов Роман Олегович", Новый Структура("ВидСпорта", Прыжки));
	ТренерТяж = Элемент(Справочники.Тренеры, "ДЕМО-04", "Воронова Ольга Юрьевна", Новый Структура("ВидСпорта", Тяжелая));
	А1 = Спортсмен("ДЕМО-01", "Громов Даниил Игоревич", Арм, ТренерАрм);
	А2 = Спортсмен("ДЕМО-02", "Белова Алиса Павловна", Арм, ТренерАрм);
	А3 = Спортсмен("ДЕМО-03", "Поляков Иван Денисович", Арм, ТренерАрм);
	Б1 = Спортсмен("ДЕМО-04", "Зайцева Елена Денисовна", Бег, ТренерБег);
	Б2 = Спортсмен("ДЕМО-05", "Лебедев Кирилл Артемович", Бег, ТренерБег);
	Б3 = Спортсмен("ДЕМО-06", "Мельникова София Олеговна", Бег, ТренерБег);
	Спортсмен("ДЕМО-07", "Романова Анна Павловна", Прыжки, ТренерПрыжки);
	Спортсмен("ДЕМО-08", "Никитин Максим Ильич", Прыжки, ТренерПрыжки);
	Спортсмен("ДЕМО-09", "Быков Егор Викторович", Тяжелая, ТренерТяж);
	Спортсмен("ДЕМО-10", "Гусева Вера Тимуровна", Тяжелая, ТренерТяж);

	К1 = Команда("ДЕМО-01", "Вектор", Арм, ТренерАрм, А1);
	К2 = Команда("ДЕМО-02", "Форсаж", Арм, ТренерАрм, А2);
	К3 = Команда("ДЕМО-03", "Темп", Арм, ТренерАрм, А3);

	Ф = Перечисления.ФорматыСоревнований;
	С = Перечисления.СтатусыМероприятий;
	Кубок = НовоеМероприятие("Кубок «Олимпа» по армрестлингу", Арм, АрмЗал, Дата(2026,11,7,10,0,0), Дата(2026,11,7,12,0,0), Ф.Личный, 8);
	Кубок.Записать(РежимЗаписиДокумента.Проведение);
	Рег = НоваяРегистрация(Кубок.Ссылка, СтрВМассив(А1, А2, А3));
	Рег.Записать(РежимЗаписиДокумента.Проведение);
	ЗакрытьИНаградить(Кубок, СтрВМассив(А1, А2, А3), СтрВМассив(12,12,8));

	Забег = НовоеМероприятие("Контрольный забег на 100 м", Бег, Дорожка, Дата(2026,11,8,11,0,0), Дата(2026,11,8,12,30,0), Ф.Личный, 10);
	Забег.Записать(РежимЗаписиДокумента.Проведение);
	Рег = НоваяРегистрация(Забег.Ссылка, СтрВМассив(Б1, Б2, Б3));
	Рег.Записать(РежимЗаписиДокумента.Проведение);
	ЗакрытьИНаградить(Забег, СтрВМассив(Б1, Б2, Б3), СтрВМассив(13.85,13.10,13.44));

	Турнир = НовоеМероприятие("Командная лига «Сильная рука»", Арм, ИгровойЗал, Дата(2026,11,28,11,0,0), Дата(2026,11,28,14,0,0), Ф.Командный, 3);
	Турнир.Записать(РежимЗаписиДокумента.Проведение);
	Рег = НоваяРегистрация(Турнир.Ссылка, СтрВМассив(К1, К2, К3));
	Рег.Записать(РежимЗаписиДокумента.Проведение);

	Старт = НовоеМероприятие("Первенство по прыжкам в длину", Прыжки, Сектор, Дата(2026,11,29,10,0,0), Дата(2026,11,29,12,0,0), Ф.Личный, 12);
	Старт.Записать(РежимЗаписиДокумента.Проведение);

	Сбор = НовоеМероприятие("Открытый помост", Тяжелая, Помост, Дата(2026,11,30,10,0,0), Дата(2026,11,30,12,0,0), Ф.Личный, 8);
	Сбор.Статус = С.Отменено;
	Сбор.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры

Функция Элемент(Менеджер, Код, Наименование, Поля)
	Объект = Менеджер.СоздатьЭлемент();
	Объект.Код = Код;
	Объект.Наименование = Наименование;
	ЗаполнитьЗначенияСвойств(Объект, Поля);
	Объект.Записать();
	Возврат Объект.Ссылка;
КонецФункции

Функция Площадка(Код, Название, Объект, Вместимость)
	Возврат Элемент(Справочники.Площадки, Код, Название,
		Новый Структура("СпортивныйОбъект,Вместимость", Объект, Вместимость));
КонецФункции

Функция ВидСпорта(Код, Название, Показатель, Единица)
	Возврат Элемент(Справочники.ВидыСпорта, Код, Название, Новый Структура("Показатель,Единица", Показатель, Единица));
КонецФункции

Функция Спортсмен(Код, ФИО, Вид, Тренер)
	Возврат Элемент(Справочники.Спортсмены, Код, ФИО, Новый Структура("ВидСпорта,Тренер", Вид, Тренер));
КонецФункции

Функция Команда(Код, Название, Вид, Тренер, Участник)
	Объект = Справочники.Команды.СоздатьЭлемент();
	Объект.Код = Код;
	Объект.Наименование = Название;
	Объект.ВидСпорта = Вид;
	Объект.Тренер = Тренер;
	Объект.Состав.Добавить().Спортсмен = Участник;
	Объект.Записать();
	Возврат Объект.Ссылка;
КонецФункции

Функция НовоеМероприятие(Название, Вид, Площадка, Начало, Окончание, Формат, Лимит)
	Объект = Документы.Мероприятие.СоздатьДокумент();
	Объект.Название = Название;
	Объект.Дата = НачалоДня(Начало);
	Объект.ВидСпорта = Вид;
	Объект.Организатор = "Спортивный клуб «Старт»";
	Объект.Начало = Начало;
	Объект.Окончание = Окончание;
	Объект.Площадка = Площадка;
	Объект.Формат = Формат;
	Объект.Лимит = Лимит;
	Объект.Статус = Перечисления.СтатусыМероприятий.Запланировано;
	Возврат Объект;
КонецФункции

Функция НоваяРегистрация(Мероприятие, Участники)
	Объект = Документы.Регистрация.СоздатьДокумент();
	Объект.Мероприятие = Мероприятие;
	Объект.Дата = Мероприятие.Начало - 86400;
	Для Каждого Участник Из Участники Цикл
		Объект.Участники.Добавить().Участник = Участник;
	КонецЦикла;
	Возврат Объект;
КонецФункции

Функция НовыйПротокол(Мероприятие, Участники, Значения)
	Объект = Документы.Протокол.СоздатьДокумент();
	Объект.Мероприятие = Мероприятие;
	Объект.Дата = Мероприятие.Окончание;
	Для Номер = 0 По Участники.Количество() - 1 Цикл
		Строка = Объект.Результаты.Добавить();
		Строка.Участник = Участники[Номер];
		Строка.Результат = Значения[Номер];
	КонецЦикла;
	Возврат Объект;
КонецФункции

Процедура ЗакрытьИНаградить(Мероприятие, Участники, Значения)
	Мероприятие.Статус = Перечисления.СтатусыМероприятий.РегистрацияЗакрыта;
	Мероприятие.Записать(РежимЗаписиДокумента.Проведение);
	Протокол = НовыйПротокол(Мероприятие.Ссылка, Участники, Значения);
	Протокол.Результаты[0].Примечание = "Результат подтвержден судьей";
	Протокол.Записать(РежимЗаписиДокумента.Проведение);
	Мероприятие.Статус = Перечисления.СтатусыМероприятий.Завершено;
	Мероприятие.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры

Функция СтрВМассив(Знач Первый, Знач Второй = Неопределено, Знач Третий = Неопределено)
	Массив = Новый Массив;
	Массив.Добавить(Первый);
	Если Второй <> Неопределено Тогда
		Массив.Добавить(Второй);
	КонецЕсли;
	Если Третий <> Неопределено Тогда
		Массив.Добавить(Третий);
	КонецЕсли;
	Возврат Массив;
КонецФункции

Функция ПримерМероприятия() Экспорт
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 М.Ссылка КАК Ссылка ИЗ Документ.Мероприятие КАК М
		|ГДЕ М.Название = ""Кубок «Олимпа» по армрестлингу"" И М.Проведен");
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Документы.Мероприятие.ПустаяСсылка());
КонецФункции

Функция ПодготовитьКонфликт() Экспорт
	Пример = ПримерМероприятия();
	Копия = НовоеМероприятие("Проверка бронирования", Пример.ВидСпорта, Пример.Площадка,
		Пример.Начало + 1800, Пример.Окончание - 1800, Пример.Формат, 5);
	Копия.Записать();
	Возврат Копия.Ссылка;
КонецФункции

Функция ЗапускПроверок() Экспорт
	Журнал = Новый Массив;
	НачальныеДанные();
	Попытка
		ПроверитьГотовыеДанные(Журнал);
		ПроверитьЖизненныйЦикл(Журнал);
		ПроверитьОтчеты(Журнал);
		Журнал.Добавить("ИТОГ: ПРОЙДЕНО");
	Исключение
		Журнал.Добавить("ИТОГ: ОШИБКА");
		Журнал.Добавить(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат СтрСоединить(Журнал, Символы.ПС);
КонецФункции

Процедура ПроверитьГотовыеДанные(Журнал)
	Проверить(КоличествоДанных("Справочник.СпортивныеОбъекты") = 3, "3 спортивных объекта");
	Проверить(КоличествоДанных("Справочник.Площадки") = 5, "5 площадок");
	Проверить(КоличествоДанных("Справочник.ВидыСпорта") = 4, "4 вида спорта");
	Проверить(КоличествоДанных("Справочник.Спортсмены") = 10, "10 спортсменов");
	Проверить(КоличествоДанных("Справочник.Команды") = 3, "3 команды");
	Журнал.Добавить("PASS | Состав демонстрационных справочников.");
	Пример = ПримерМероприятия();
	Данные = СпортивныеОтчеты.Данные("ИтоговыйПротокол", Новый Структура("Мероприятие", Пример));
	Проверить(Данные.Количество() = 3 И Данные[0].Место = 1 И Данные[1].Место = 1 И Данные[2].Место = 3, "Ничья 1, 1, 3");
	Журнал.Добавить("PASS | 08. Итоговый протокол. Очки, ничья 1, 1, 3.");
	Показатели = Перечисления.ПоказателиРезультата;
	Для Каждого Показатель Из СтрВМассив(Показатели.Время, Показатели.Расстояние, Показатели.Вес) Цикл
		Проба = НовыйПротокол(Пример, СтрВМассив(Данные[0].Участник, Данные[1].Участник), СтрВМассив(10,20));
		СпортивныеПравила.РассчитатьМеста(Проба.Результаты, Показатель);
		Проверить(Проба.Результаты[0].Место = ?(Показатель = Показатели.Время,1,2), "Направление ранжирования");
	КонецЦикла;
	Журнал.Добавить("PASS | 07. Расчет мест по времени, очкам, расстоянию и весу.");
КонецПроцедуры

Процедура ПроверитьЖизненныйЦикл(Журнал)
	Пример = ПримерМероприятия();
	А1 = Справочники.Спортсмены.НайтиПоКоду("ДЕМО-01");
	А2 = Справочники.Спортсмены.НайтиПоКоду("ДЕМО-02");
	А3 = Справочники.Спортсмены.НайтиПоКоду("ДЕМО-03");
	Команда = Справочники.Команды.НайтиПоКоду("ДЕМО-01");
	Режим = РежимЗаписиДокумента.Проведение;
	Отмена = РежимЗаписиДокумента.ОтменаПроведения;
	С = Перечисления.СтатусыМероприятий;
	М = НовоеМероприятие("Испытание расписания", Пример.ВидСпорта, Пример.Площадка,
		Пример.Окончание, Пример.Окончание + 3600, Пример.Формат, 2);
	М.Записать(Режим);
	Проверить(М.Проведен, "Смежные интервалы");
	Журнал.Добавить("PASS | 01, 05. Мероприятие создано и проведено на границе предыдущего бронирования.");
	Конфликт = НовоеМероприятие("Испытание пересечения", Пример.ВидСпорта, Пример.Площадка,
		Пример.Начало + 1800, Пример.Окончание - 1800, Пример.Формат, 2);
	ДолженОтклониться(Конфликт, Режим, "Площадка занята");
	Журнал.Добавить("PASS | 04, 11. Пересечение запрещено, ожидаемый текст получен через БСП.");

	Р1 = НоваяРегистрация(М.Ссылка, СтрВМассив(А1));
	Р1.Записать(Режим);
	Р1.Записать(Режим);
	Проверить(СпортивныеПравила.Участники(М.Ссылка).Количество() = 1, "Перепроведение регистрации");
	Журнал.Добавить("PASS | 02. Спортсмен зарегистрирован, повторное проведение не удвоило учет.");
	ДолженОтклониться(НоваяРегистрация(М.Ссылка, СтрВМассив(А1)), Режим, "уже зарегистрирован");
	ДолженОтклониться(НоваяРегистрация(М.Ссылка, СтрВМассив(Команда)), Режим, "соответствовать формату");
	ДолженОтклониться(НоваяРегистрация(М.Ссылка, СтрВМассив(А2,А3)), Режим, "Превышен лимит");
	Р2 = НоваяРегистрация(М.Ссылка, СтрВМассив(А2));
	Р2.Записать(Режим);
	Р2.Записать(Отмена);
	Проверить(СпортивныеПравила.Участники(М.Ссылка).Количество() = 1, "Снятие регистрации");
	Р2.Записать(Режим);
	Журнал.Добавить("PASS | 03. Запрещены дубль, неверный формат и превышение лимита, снятие регистрации обновило учет.");

	М.Статус = С.РегистрацияЗакрыта;
	М.Записать(Режим);
	ДолженОтклониться(НоваяРегистрация(М.Ссылка, СтрВМассив(А3)), Режим, "Регистрация закрыта");
	ДолженОтклониться(НовыйПротокол(М.Ссылка, СтрВМассив(А3), СтрВМассив(9)), Режим, "только зарегистрированных");
	Протокол = НовыйПротокол(М.Ссылка, СтрВМассив(А1,А2), СтрВМассив(10,12));
	Протокол.Результаты[0].МестоВручную = 1;
	ДолженОтклониться(Протокол, Режим, "заполните причину");
	Протокол.Результаты[0].Причина = "Решение судьи по апелляции";
	Протокол.Результаты[1].МестоВручную = 2;
	Протокол.Результаты[1].Причина = "Пересмотр итогового порядка";
	Протокол.Записать(Режим);
	Проверить(Протокол.Результаты[0].Место = 1, "Ручное место");
	ДолженОтклониться(Р2, Отмена, "Сначала снимите проведение");
	ДолженОтклониться(НовыйПротокол(М.Ссылка, СтрВМассив(А1), СтрВМассив(9)), Режим, "уже есть проведенный протокол");
	Журнал.Добавить("PASS | 06. Проверка регистрации в протоколе, единственности протокола, ручного места и причины.");

	Отбор = Новый Структура("Мероприятие", М.Ссылка);
	Протокол.Записать(Отмена);
	Проверить(СпортивныеОтчеты.Данные("ИтоговыйПротокол", Отбор).Количество() = 0, "Снятие протокола удаляет итоги");
	Протокол.Записать(Режим);
	Протокол.Записать(Режим);
	Проверить(СпортивныеОтчеты.Данные("ИтоговыйПротокол", Отбор).Количество() = 2, "Две строки после перепроведения");
	Журнал.Добавить("PASS | 10. Снятие проведения и повторное проведение протокола заменяют движения.");
	М.Статус = С.Отменено;
	М.Записать(Режим);
	Проверить(СпортивныеОтчеты.Данные("ИтоговыйПротокол", Отбор).Количество() = 0, "Отмена скрывает итоги");
	Проверить(СпортивныеПравила.Пересечение(М.Площадка, М.Начало, М.Окончание, Документы.Мероприятие.ПустаяСсылка()) = Неопределено,
		"Отмена освобождает площадку");
	Журнал.Добавить("PASS | 09. Отмена освободила площадку и исключила результаты из итогового отчета.");
КонецПроцедуры

Процедура ПроверитьОтчеты(Журнал)
	Пример = ПримерМероприятия();
	Отбор = Новый Структура("НачалоПериода,КонецПериода,СпортивныйОбъект,Площадка,ВидСпорта,Статус",
		Дата(2026,11,7), Дата(2026,11,7), Пример.Площадка.СпортивныйОбъект, Пример.Площадка, Пример.ВидСпорта, Пример.Статус);
	Календарь = СпортивныеОтчеты.Данные("Календарь", Отбор);
	Проверить(Календарь.Количество() = 1, "Отборы календаря");
	Загрузка = СпортивныеОтчеты.Данные("ЗагрузкаПлощадок", Отбор);
	Проверить(Загрузка.Количество() = 1 И Загрузка[0].Часы = 2, "Два часа нагрузки");
	Рейтинг = СпортивныеОтчеты.Данные("РейтингСпортсменов", Новый Структура("НачалоПериода,КонецПериода,ВидСпорта",
		Дата(2026,11,1), Дата(2026,11,30), Пример.ВидСпорта));
	Проверить(Рейтинг.Количество() = 3 И Рейтинг[0].Победы = 1, "Рейтинг спортсменов");
	Проверить(СпортивныеОтчеты.Данные("СписокУчастников", Новый Структура("Мероприятие", Пример)).Количество() = 3,
		"Список участников");
	Для Каждого ИмяОтчета Из СтрРазделить("Календарь,ЗагрузкаПлощадок,СписокУчастников,ИтоговыйПротокол,РейтингСпортсменов", ",") Цикл
		Параметры = ?(ИмяОтчета = "СписокУчастников" Или ИмяОтчета = "ИтоговыйПротокол",
			Новый Структура("Мероприятие", Пример), Отбор);
		ТабДок = СпортивныеОтчеты.Сформировать(ИмяОтчета, Параметры);
		Проверить(ТабДок.ВысотаТаблицы > 5, "Вывод табличного документа " + ИмяОтчета);
	КонецЦикла;
	Журнал.Добавить("PASS | 12. Сформированы пять отчетов в табличном документе; проверены отборы, загрузка и рейтинг.");
КонецПроцедуры

Процедура ДолженОтклониться(Документ, Режим, Фраза)
	Отклонено = Ложь;
	Попытка
		Документ.Записать(Режим);
	Исключение
		Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
			Если СтрНайти(Сообщение.Текст, Фраза) > 0 Тогда
				Отклонено = Истина;
			КонецЕсли;
		КонецЦикла;
		Если Не Отклонено Тогда
			ВызватьИсключение;
		КонецЕсли;
	КонецПопытки;
	Проверить(Отклонено, Фраза);
КонецПроцедуры

Процедура Проверить(Условие, Название)
	Если Не Условие Тогда
		ВызватьИсключение "Не выполнено: " + Название;
	КонецЕсли;
КонецПроцедуры

Функция КоличествоДанных(ИмяТаблицы)
	Таблица = СпортивныеПравила.ТаблицаЗапроса(
		"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ " + ИмяТаблицы, Новый Структура);
	Возврат Таблица[0].Количество;
КонецФункции