Функция Сформировать(ИмяОтчета, Отборы, Строки = Неопределено) Экспорт
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ОтображатьСетку = Ложь;
	ТабДок.ОтображатьЗаголовки = Ложь;
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;

	ТабДок.Область("R1C1").Текст = Метаданные.Отчеты[ИмяОтчета].Синоним;
	ТабДок.Область("R1C1").Шрифт = Новый Шрифт("Arial", 15, Истина);
	Если Отборы.Свойство("Мероприятие") Тогда
		Если Не ЗначениеЗаполнено(Отборы.Мероприятие) Тогда
			ТабДок.Область("R3C1").Текст = "Выберите мероприятие и нажмите «Сформировать».";
			Возврат ТабДок;
		КонецЕсли;
		Событие = Отборы.Мероприятие;
		ТабДок.Область("R2C1").Текст = СтрШаблон("%1  |  %2  |  %3  |  %4",
			Событие.Название, Событие.ВидСпорта, Формат(Событие.Начало, "ДФ='dd.MM.yyyy HH:mm'"), Событие.Площадка);
		ТабДок.Область("R3C1").Текст = СтрШаблон("Организатор: %1  |  Статус: %2", Событие.Организатор, Событие.Статус);
	КонецЕсли;
	Если Отборы.Свойство("НачалоПериода") И ЗначениеЗаполнено(Отборы.НачалоПериода)
		И ЗначениеЗаполнено(Отборы.КонецПериода) И Отборы.НачалоПериода > Отборы.КонецПериода Тогда
		ТабДок.Область("R3C1").Текст = "Начало периода должно быть не позже его окончания.";
		Возврат ТабДок;
	КонецЕсли;
	Если Строки = Неопределено Тогда
		Строки = Данные(ИмяОтчета, Отборы);
	КонецЕсли;
	Поля = НастройкаКолонок(ИмяОтчета);
	Колонка = 0;
	Для Каждого Описание Из Поля Цикл
		Колонка = Колонка + 1;
		Ячейка = ТабДок.Область(5, Колонка);
		Ячейка.ШиринаКолонки = Описание.Ширина;
		Ячейка.ЦветФона = Новый Цвет(31, 67, 94);
		Ячейка.ЦветТекста = Новый Цвет(255, 255, 255);
		Ячейка.Шрифт = Новый Шрифт("Arial", 10, Истина);
		Ячейка.Текст = Описание.Заголовок;
	КонецЦикла;
	НомерСтроки = 5;
	Для Каждого СтрокаОтчета Из Строки Цикл
		НомерСтроки = НомерСтроки + 1;
		Колонка = 0;
		Для Каждого Описание Из Поля Цикл
			Колонка = Колонка + 1;
			Ячейка = ТабДок.Область(НомерСтроки, Колонка);
			Значение = СтрокаОтчета[Описание.Имя];
			Ячейка.Текст = ?(ТипЗнч(Значение) = Тип("Дата"), Формат(Значение, "ДФ='dd.MM.yyyy HH:mm'"), Строка(Значение));
			Ячейка.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
			Если НомерСтроки % 2 = 0 Тогда
				Ячейка.ЦветФона = Новый Цвет(237, 244, 248);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если Строки.Количество() = 0 Тогда
		ТабДок.Область("R6C1").Текст = "По заданным условиям данных нет.";
	КонецЕсли;
	ТабДок.Область(НомерСтроки + 2, 1).Текст = СтрШаблон("Строк в отчете: %1", Строки.Количество());
	Если ИмяОтчета = "СписокУчастников" И Строки.Количество() > 0 Тогда
		НомерСтроки = НомерСтроки + 4;
		ТабДок.Область(НомерСтроки, 1).Текст = "Дата";
		ТабДок.Область(НомерСтроки, 2).Текст = "Зарегистрировано";
		ТабДок.Область(НомерСтроки, 3).Текст = "Доля заявок";
		Для Каждого СтрокаДня Из РегистрацииПоДням(Строки) Цикл
			НомерСтроки = НомерСтроки + 1;
			ТабДок.Область(НомерСтроки, 1).Текст = Формат(СтрокаДня.День, "ДФ='dd.MM.yyyy'");
			ТабДок.Область(НомерСтроки, 2).Текст = Строка(СтрокаДня.Количество);
			ТабДок.Область(НомерСтроки, 3).Текст = СтрокаДня.Доля;
		КонецЦикла;
	КонецЕсли;
	Возврат ТабДок;
КонецФункции

Функция НастройкаКолонок(ИмяОтчета)
	Если ИмяОтчета = "Календарь" Тогда
		СтрокаКолонок = "Начало|Начало|17;Окончание|Окончание|17;Название|Мероприятие|29;СпортивныйОбъект|Объект|21;Площадка|Площадка|22;ВидСпорта|Вид спорта|15;Статус|Статус|20;Часы|Длительность, часов|16;Доля|Доля времени|15";
	ИначеЕсли ИмяОтчета = "ЗагрузкаПлощадок" Тогда
		СтрокаКолонок = "СпортивныйОбъект|Объект|24;Площадка|Площадка|26;Бронирования|Бронирований|15;Часы|Занято, часов|16;Доля|Доля занятости|15";
	ИначеЕсли ИмяОтчета = "СписокУчастников" Тогда
		СтрокаКолонок = "Участник|Участник|32;ДатаРегистрации|Дата регистрации|21;Регистрация|Документ регистрации|32";
	ИначеЕсли ИмяОтчета = "ИтоговыйПротокол" Тогда
		СтрокаКолонок = "Место|Место|9;Участник|Участник|30;Результат|Результат|13;Единица|Ед. изм.|10;Примечание|Примечание|25;Причина|Причина изменения места|31;Доля|К лучшему|14";
	Иначе
		СтрокаКолонок = "Участник|Спортсмен|34;ВидСпорта|Вид спорта|20;Старты|Стартов|11;Победы|Побед|10;Призовые|Призовых мест|16;СреднееМесто|Среднее место|16;Доля|Доля побед|14";
	КонецЕсли;
	Колонки = Новый Массив;
	Для Каждого К Из СтрРазделить(СтрокаКолонок, ";") Цикл
		Свойства = СтрРазделить(К, "|");
		Колонки.Добавить(Новый Структура("Имя,Заголовок,Ширина", Свойства[0], Свойства[1], Число(Свойства[2])));
	КонецЦикла;
	Возврат Колонки;
КонецФункции

Функция Данные(ИмяОтчета, Отборы) Экспорт
	Если ИмяОтчета = "СписокУчастников" Тогда
		Возврат СпортивныеПравила.Участники(Отборы.Мероприятие);
	ИначеЕсли ИмяОтчета = "ИтоговыйПротокол" Тогда
		Строки = СпортивныеПравила.ТаблицаЗапроса(
			"ВЫБРАТЬ Итоги.Место КАК Место, Итоги.Участник КАК Участник, Итоги.Результат КАК Результат,
			| Итоги.Мероприятие.ВидСпорта.Единица КАК Единица, Итоги.Примечание КАК Примечание, Итоги.Причина КАК Причина
			|ИЗ РегистрСведений.ИтогиСоревнований КАК Итоги
			|ГДЕ Итоги.Мероприятие = &Мероприятие И Итоги.Мероприятие.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыМероприятий.Отменено)
			|УПОРЯДОЧИТЬ ПО Место, Участник", Отборы);
		Строки.Колонки.Добавить("Доля");
		Если Строки.Количество() > 0 Тогда
			МеньшеЛучше = Отборы.Мероприятие.ВидСпорта.Показатель = Перечисления.ПоказателиРезультата.Время;
			ЛучшийРезультат = Строки[0].Результат;
			Для Каждого СтрокаОтчета Из Строки Цикл
				ЛучшийРезультат = ?(МеньшеЛучше, Мин(ЛучшийРезультат, СтрокаОтчета.Результат),
					Макс(ЛучшийРезультат, СтрокаОтчета.Результат));
			КонецЦикла;
			Для Каждого СтрокаОтчета Из Строки Цикл
				СтрокаОтчета.Доля = ?(МеньшеЛучше, ДоляВПроцентах(ЛучшийРезультат, СтрокаОтчета.Результат),
					ДоляВПроцентах(СтрокаОтчета.Результат, ЛучшийРезультат));
			КонецЦикла;
		КонецЕсли;
		Возврат Строки;
	КонецЕсли;

	Параметры = Новый Структура;
	НачалоПериода = ?(ЗначениеЗаполнено(Отборы.НачалоПериода), НачалоДня(Отборы.НачалоПериода), Дата(1,1,1));
	КонецПериода = ?(ЗначениеЗаполнено(Отборы.КонецПериода), КонецДня(Отборы.КонецПериода) + 1, Дата(3999,12,31));
	Параметры.Вставить("НачалоПериода", НачалоПериода);
	Параметры.Вставить("КонецПериода", КонецПериода);
	Условия = "
		| И М.Начало < &КонецПериода И М.Окончание > &НачалоПериода";
	ЗначениеОтбора = Неопределено;
	Для Каждого Имя Из СтрРазделить("СпортивныйОбъект,Площадка,ВидСпорта,Статус", ",") Цикл
		Если Отборы.Свойство(Имя, ЗначениеОтбора) И ЗначениеЗаполнено(ЗначениеОтбора) Тогда
			Условия = Условия + " И М." + ?(Имя = "СпортивныйОбъект", "Площадка.СпортивныйОбъект", Имя) + " = &" + Имя;
			Параметры.Вставить(Имя, ЗначениеОтбора);
		КонецЕсли;
	КонецЦикла;

	Если ИмяОтчета = "Календарь" Тогда
		Текст = "ВЫБРАТЬ М.Начало КАК Начало, М.Окончание КАК Окончание, М.Название КАК Название,
			| М.Площадка.СпортивныйОбъект КАК СпортивныйОбъект, М.Площадка КАК Площадка,
			| М.ВидСпорта КАК ВидСпорта, М.Статус КАК Статус,
			| ВЫРАЗИТЬ(РАЗНОСТЬДАТ(М.Начало, М.Окончание, СЕКУНДА) / 3600.0 КАК ЧИСЛО(15,2)) КАК Часы
			|ИЗ Документ.Мероприятие КАК М
			|ГДЕ М.Проведен" + Условия + "
			|УПОРЯДОЧИТЬ ПО Начало, Название";
	ИначеЕсли ИмяОтчета = "ЗагрузкаПлощадок" Тогда
		Текст = "ВЫБРАТЬ М.Площадка.СпортивныйОбъект КАК СпортивныйОбъект, М.Площадка КАК Площадка,
			| КОЛИЧЕСТВО(*) КАК Бронирования,
			| ВЫРАЗИТЬ(СУММА(РАЗНОСТЬДАТ(
			| ВЫБОР КОГДА М.Начало < &НачалоПериода ТОГДА &НачалоПериода ИНАЧЕ М.Начало КОНЕЦ,
			| ВЫБОР КОГДА М.Окончание > &КонецПериода ТОГДА &КонецПериода ИНАЧЕ М.Окончание КОНЕЦ,
			| СЕКУНДА)) / 3600.0 КАК ЧИСЛО(15,2)) КАК Часы
			|ИЗ РегистрСведений.БронированияПлощадок КАК Б
			| ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Мероприятие КАК М ПО Б.Регистратор = М.Ссылка
			|ГДЕ М.Проведен" + Условия + "
			|СГРУППИРОВАТЬ ПО М.Площадка.СпортивныйОбъект, М.Площадка
			|УПОРЯДОЧИТЬ ПО Часы УБЫВ";
	Иначе
		Текст = "ВЫБРАТЬ Итоги.Участник КАК Участник, М.ВидСпорта КАК ВидСпорта,
			| КОЛИЧЕСТВО(*) КАК Старты, СУММА(ВЫБОР КОГДА Итоги.Место = 1 ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК Победы,
			| СУММА(ВЫБОР КОГДА Итоги.Место <= 3 ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК Призовые,
			| ВЫРАЗИТЬ(СРЕДНЕЕ(Итоги.Место) КАК ЧИСЛО(8,2)) КАК СреднееМесто
			|ИЗ РегистрСведений.ИтогиСоревнований КАК Итоги
			| ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Мероприятие КАК М ПО Итоги.Мероприятие = М.Ссылка
			|ГДЕ Итоги.Участник ССЫЛКА Справочник.Спортсмены И М.Проведен
			| И М.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыМероприятий.Отменено)" + Условия + "
			|СГРУППИРОВАТЬ ПО Итоги.Участник, М.ВидСпорта
			|УПОРЯДОЧИТЬ ПО Победы УБЫВ, Призовые УБЫВ, СреднееМесто, Участник";
	КонецЕсли;
	Строки = СпортивныеПравила.ТаблицаЗапроса(Текст, Параметры);
	Строки.Колонки.Добавить("Доля");
	Если ИмяОтчета = "РейтингСпортсменов" Тогда
		Для Каждого СтрокаОтчета Из Строки Цикл
			СтрокаОтчета.Доля = ДоляВПроцентах(СтрокаОтчета.Победы, СтрокаОтчета.Старты);
		КонецЦикла;
	Иначе
		ВсегоЧасов = Строки.Итог("Часы");
		Для Каждого СтрокаОтчета Из Строки Цикл
			СтрокаОтчета.Доля = ДоляВПроцентах(СтрокаОтчета.Часы, ВсегоЧасов);
		КонецЦикла;
	КонецЕсли;
	Возврат Строки;
КонецФункции

Процедура ЗаполнитьДиаграмму(Диаграмма, Строки, ИмяОтчета) Экспорт
	Диаграмма.Очистить();
	Диаграмма.ТипДиаграммы = ТипДиаграммы.Гистограмма;
	Если ИмяОтчета = "Календарь" Или ИмяОтчета = "ЗагрузкаПлощадок" Тогда
		Серия = Диаграмма.Серии.Добавить("Часы");
		Для Каждого СтрокаОтчета Из Строки Цикл
			Если ИмяОтчета = "Календарь" Тогда
				Подпись = СтрокаОтчета.Название + " (" + Формат(СтрокаОтчета.Начало, "ДФ='dd.MM HH:mm'") + ")";
			Иначе
				Подпись = Строка(СтрокаОтчета.СпортивныйОбъект) + " / " + Строка(СтрокаОтчета.Площадка);
			КонецЕсли;
			Точка = Диаграмма.Точки.Добавить(Подпись + " · " + СтрокаОтчета.Доля);
			Диаграмма.УстановитьЗначение(Точка, Серия, СтрокаОтчета.Часы);
		КонецЦикла;
	ИначеЕсли ИмяОтчета = "СписокУчастников" Тогда
		Серия = Диаграмма.Серии.Добавить("Зарегистрировано");
		Для Каждого СтрокаИтогов Из РегистрацииПоДням(Строки) Цикл
			Точка = Диаграмма.Точки.Добавить(Формат(СтрокаИтогов.День, "ДФ='dd.MM.yyyy'") + " · " + СтрокаИтогов.Доля);
			Диаграмма.УстановитьЗначение(Точка, Серия, СтрокаИтогов.Количество);
		КонецЦикла;
	ИначеЕсли ИмяОтчета = "ИтоговыйПротокол" Тогда
		Серия = Диаграмма.Серии.Добавить(?(Строки.Количество() = 0, "Результат", Строка(Строки[0].Единица)));
		Для Каждого СтрокаОтчета Из Строки Цикл
			Точка = Диаграмма.Точки.Добавить(Строка(СтрокаОтчета.Участник) + " · " + СтрокаОтчета.Доля);
			Диаграмма.УстановитьЗначение(Точка, Серия, СтрокаОтчета.Результат);
		КонецЦикла;
	ИначеЕсли ИмяОтчета = "РейтингСпортсменов" Тогда
		Старты = Диаграмма.Серии.Добавить("Старты");
		Победы = Диаграмма.Серии.Добавить("Победы");
		Для Каждого СтрокаОтчета Из Строки Цикл
			Точка = Диаграмма.Точки.Добавить(Строка(СтрокаОтчета.Участник) + " / " + Строка(СтрокаОтчета.ВидСпорта) + " · " + СтрокаОтчета.Доля);
			Диаграмма.УстановитьЗначение(Точка, Старты, СтрокаОтчета.Старты);
			Диаграмма.УстановитьЗначение(Точка, Победы, СтрокаОтчета.Победы);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Функция РегистрацииПоДням(Строки)
	Итоги = Новый ТаблицаЗначений;
	Итоги.Колонки.Добавить("День");
	Итоги.Колонки.Добавить("Количество");
	Для Каждого Запись Из Строки Цикл
		СтрокаДня = Итоги.Добавить();
		СтрокаДня.День = НачалоДня(Запись.ДатаРегистрации);
		СтрокаДня.Количество = 1;
	КонецЦикла;
	Итоги.Свернуть("День", "Количество");
	Итоги.Сортировать("День");
	Итоги.Колонки.Добавить("Доля");
	Для Каждого СтрокаДня Из Итоги Цикл
		СтрокаДня.Доля = ДоляВПроцентах(СтрокаДня.Количество, Строки.Количество());
	КонецЦикла;
	Возврат Итоги;
КонецФункции

Функция ДоляВПроцентах(Часть, Основание)
	Если Основание = 0 Тогда
		Возврат "–";
	КонецЕсли;
	Возврат Формат(Окр(100 * Часть / Основание, 1), "ЧДЦ=1; ЧН=0,0") + " %";
КонецФункции
