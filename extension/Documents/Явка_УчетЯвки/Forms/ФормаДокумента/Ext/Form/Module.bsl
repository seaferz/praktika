
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ПредыдущееМероприятие = Объект.Мероприятие;
	Элементы.ОбъектМероприятие.ТолькоПросмотр = ЗначениеЗаполнено(Объект.Ссылка) И ЗначениеЗаполнено(Объект.Мероприятие);
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	Элементы.ОбъектМероприятие.ТолькоПросмотр = ЗначениеЗаполнено(Объект.Мероприятие);
КонецПроцедуры

&НаКлиенте
Асинх Процедура МероприятиеПриИзменении(Элемент)
	Если Объект.Мероприятие = ПредыдущееМероприятие Тогда
		Возврат;
	КонецЕсли;
	Если Объект.Участники.Количество() > 0 Тогда
		Ответ = Ждать ВопросАсинх("При смене мероприятия строки явки будут очищены. Продолжить?",
			РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Объект.Мероприятие = ПредыдущееМероприятие;
			Возврат;
		КонецЕсли;
		Объект.Участники.Очистить();
	КонецЕсли;
	ПредыдущееМероприятие = Объект.Мероприятие;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьУчастников(Команда)
	ЗаполнитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	Если Не Явка_Правила.Действует(Объект.Мероприятие) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выберите действующее проведенное мероприятие.", , "Объект.Мероприятие");
		Возврат;
	КонецЕсли;
	Учет = СпортивныеПравила.Участники(Объект.Мероприятие);
	Снятые = Новый Массив;
	ЕстьВСтроках = Новый Соответствие;
	Для Каждого СтрокаЯвки Из Объект.Участники Цикл
		Если Учет.Найти(СтрокаЯвки.Участник, "Участник") = Неопределено Тогда
			Снятые.Добавить(СтрокаЯвки);
		Иначе
			ЕстьВСтроках.Вставить(СтрокаЯвки.Участник, Истина);
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаЯвки Из Снятые Цикл
		Объект.Участники.Удалить(СтрокаЯвки);
	КонецЦикла;
	Для Каждого Запись Из Учет Цикл
		Если ЕстьВСтроках.Получить(Запись.Участник) = Неопределено Тогда
			Объект.Участники.Добавить().Участник = Запись.Участник;
		КонецЕсли;
	КонецЦикла;
	Если Учет.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У мероприятия нет проведенных регистраций.");
	КонецЕсли;
КонецПроцедуры
