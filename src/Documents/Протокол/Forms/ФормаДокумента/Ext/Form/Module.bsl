&НаКлиенте
Процедура РассчитатьМеста(Команда)
	РассчитатьМестаНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьУчастников(Команда)
	ЗаполнитьУчастниковНаСервере();
КонецПроцедуры

&НаСервере
Процедура РассчитатьМестаНаСервере()
	Если Не ЗначениеЗаполнено(Объект.Мероприятие) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выберите мероприятие.", , "Объект.Мероприятие");
		Возврат;
	КонецЕсли;
	СпортивныеПравила.РассчитатьМеста(Объект.Результаты, Объект.Мероприятие.ВидСпорта.Показатель);
	Модифицированность = Истина;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьУчастниковНаСервере()
	Если Не ЗначениеЗаполнено(Объект.Мероприятие) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выберите мероприятие.", , "Объект.Мероприятие");
		Возврат;
	КонецЕсли;
	УжеВПротоколе = Новый Соответствие;
	Для Каждого СтрокаРезультата Из Объект.Результаты Цикл
		УжеВПротоколе.Вставить(СтрокаРезультата.Участник, Истина);
	КонецЦикла;
	Для Каждого СтрокаУчета Из СпортивныеПравила.Участники(Объект.Мероприятие) Цикл
		Если УжеВПротоколе.Получить(СтрокаУчета.Участник) = Неопределено Тогда
			Объект.Результаты.Добавить().Участник = СтрокаУчета.Участник;
			Модифицированность = Истина;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
