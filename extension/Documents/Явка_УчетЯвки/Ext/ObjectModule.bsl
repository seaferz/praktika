
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	СпортивныеПравила.ПроверитьИсходныйУчет(ЭтотОбъект, Отказ);
	Если Проведен И РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
		СпортивныеПравила.ОшибкаПроверки("Изменения проведенного документа сохраняются при перепроведении.", ЭтотОбъект, "", Отказ);
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Если Не ЗначениеЗаполнено(Мероприятие) Тогда
		СпортивныеПравила.ОшибкаПроверки("Выберите мероприятие.", ЭтотОбъект, "Мероприятие", Отказ);
		Возврат;
	КонецЕсли;
	СпортивныеПравила.Заблокировать("Документ.Мероприятие", Мероприятие);
	Если Не Явка_Правила.Действует(Мероприятие) Тогда
		СпортивныеПравила.ОшибкаПроверки("Выберите действующее проведенное мероприятие.", ЭтотОбъект, "Мероприятие", Отказ);
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(Явка_Правила.ДокументЯвки(Мероприятие, Ссылка)) Тогда
		СпортивныеПравила.ОшибкаПроверки("По мероприятию уже проведен документ явки. Откройте его для уточнения отметок.",
			ЭтотОбъект, "Мероприятие", Отказ);
		Возврат;
	КонецЕсли;

	Учет = СпортивныеПравила.Участники(Мероприятие);
	ОтмеченныеСтроки = Новый Соответствие;
	Набор = Движения.Явка_ОтметкиУчастников;
	Набор.Записывать = Истина;
	Набор.Очистить();
	Для Каждого СтрокаУчастника Из Участники Цикл
		Участник = СтрокаУчастника.Участник;
		Поле = СтрШаблон("Участники[%1].Участник", СтрокаУчастника.НомерСтроки - 1);
		Если Учет.Найти(Участник, "Участник") = Неопределено Тогда
			СпортивныеПравила.ОшибкаПроверки("Учесть явку можно только для зарегистрированного участника.",
				ЭтотОбъект, Поле, Отказ);
			Возврат;
		КонецЕсли;
		Если ОтмеченныеСтроки.Получить(Участник) <> Неопределено Тогда
			СпортивныеПравила.ОшибкаПроверки("Участник повторяется в документе явки.", ЭтотОбъект, Поле, Отказ);
			Возврат;
		КонецЕсли;
		ОтмеченныеСтроки.Вставить(Участник, Истина);
		Если ЗначениеЗаполнено(СтрокаУчастника.Отметка) Тогда
			Запись = Набор.Добавить();
			Запись.Мероприятие = Мероприятие;
			Запись.Участник = Участник;
			Запись.Отметка = СтрокаУчастника.Отметка;
		КонецЕсли;
	КонецЦикла;
	Если Набор.Количество() = 0 Тогда
		СпортивныеПравила.ОшибкаПроверки("Укажите явку хотя бы одного зарегистрированного участника.",
			ЭтотОбъект, "Участники", Отказ);
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	СпортивныеПравила.Заблокировать("Документ.Мероприятие", Мероприятие);
КонецПроцедуры
