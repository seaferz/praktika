&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("Мероприятие") Тогда
	Мероприятие = Параметры.Мероприятие;
	СформироватьНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	СформироватьНаСервере();
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
	Отборы = Новый Структура("Мероприятие", Мероприятие);
	Строки = СпортивныеОтчеты.Данные("ИтоговыйПротокол", Отборы);
	РезультатОтчета = СпортивныеОтчеты.Сформировать("ИтоговыйПротокол", Отборы, Строки);
	СпортивныеОтчеты.ЗаполнитьДиаграмму(ДиаграммаОтчета, Строки, "ИтоговыйПротокол");
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьТаблица(Команда)
	Элементы.РезультатОтчета.Видимость = Истина;
	Элементы.ДиаграммаОтчета.Видимость = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьДиаграмма(Команда)
	Элементы.РезультатОтчета.Видимость = Ложь;
	Элементы.ДиаграммаОтчета.Видимость = Истина;
КонецПроцедуры
